{
  "name": "HR-System AI Rules",
  "version": "v1",
  "description": "Manifest för AI-regler som styr hur innehåll genereras i HR-Systemet. Reglerna är uppdelade i globala, ämnesspecifika och formatstyrda delar.",

  "defaults": {
    "language": "sv",
    "subject": "generic",
    "format": "training-blocks"
  },

  "global": {
    "rules": "/ai-rules/v1/global.json",
    "safety": "/ai-rules/v1/policies/safety.json"
  },

  "subjects": {
    "generic": "/ai-rules/v1/subjects/generic.json",
    "math": "/ai-rules/v1/subjects/math.json",
    "swedish": "/ai-rules/v1/subjects/swedish.json"
  },

  "formats": {
    "training-blocks": "/ai-rules/v1/formats/training-blocks.json",
    "task": "/ai-rules/v1/formats/task.json",
    "question": "/ai-rules/v1/formats/question.json"
  },

  "modes": {
    "training": {
      "allowedFormats": ["training-blocks", "task", "question"],
      "description": "Utbildningsinnehåll för onboarding och kompetensutveckling."
    },
    "document": {
      "allowedFormats": ["training-blocks"],
      "description": "Informativa dokument utan interaktiva uppgifter."
    }
  },

  "constraints": {
    "maxRulesPerRequest": 5,
    "maxCombinedRuleSize": 8000,
    "failClosed": true
  },

  "notes": [
    "Denna fil innehåller inga AI-instruktioner i klartext.",
    "Alla regler är datafiler och kan versioneras utan att ändra worker-kod.",
    "Workern ansvarar för att slå upp och kombinera regler innan AI-anrop."
  ]
}

