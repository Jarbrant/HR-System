{
  "id": "composition",
  "version": "1.0.0",
  "scope": {
    "chapters": ["tillämpning"],
    "steps": [3, 4, 5]
  },

  "principles": {
    "fail_closed": true,
    "no_freeform_theory_in_application_steps": true,
    "scenario_first_when_required": true,
    "step_outputs_must_differ": true
  },

  "defaults": {
    "forbid_blocks": ["info", "theory", "definition"],
    "forbid_patterns": [
      "Kort teori",
      "Teori kopplad till ämnet",
      "Genomgång",
      "Definition"
    ],
    "require_answer_key_for_questions": true
  },

  "rules": {
    "tillämpning": {
      "3": {
        "intent": "Kombinera och använda kunskap i en kort verklig situation. Praktiskt beslut baserat på tolkning av text.",
        "allow_blocks": ["scenario", "question", "task"],
        "forbid_blocks": ["info", "theory", "definition", "reflection", "document"],
        "order": ["scenario", "question", "task"],
        "requirements": {
          "scenario": { "min": 1, "max": 2, "must_include": ["kund/kollega", "tolkning av text", "praktiskt val"] },
          "question": {
            "min": 2,
            "max": 6,
            "allowed_question_types": ["best_choice", "multiple_choice"],
            "must_include": ["tydlighet", "kanal/ton", "bekräfta förståelse"],
            "must_have_answer_key": true
          },
          "task": { "min": 0, "max": 2 }
        },
        "step_guards": {
          "no_reuse_from_step_1_2": true,
          "no_intro_explanations": true
        }
      },

      "4": {
        "intent": "Analysera kommunikationen i ett scenario: hitta risk för missförstånd, förbättra formulering, förklara varför.",
        "allow_blocks": ["scenario", "question", "task"],
        "forbid_blocks": ["info", "theory", "definition", "document"],
        "order": ["scenario", "question", "task"],
        "requirements": {
          "scenario": { "min": 1, "max": 2, "must_include": ["missförståndsrisk", "oklar instruktion eller ton", "konsekvens"] },
          "question": {
            "min": 3,
            "max": 8,
            "allowed_question_types": ["best_choice", "multiple_choice", "short_answer"],
            "must_include": ["felorsak", "förbättring", "varför"],
            "must_have_answer_key": true
          },
          "task": {
            "min": 1,
            "max": 2,
            "must_include": ["skriv om", "förtydliga", "bekräfta förståelse"]
          }
        },
        "step_guards": {
          "require_analysis_language": true,
          "no_basic_definitions": true
        }
      },

      "5": {
        "intent": "Behärska och ta ansvar: hantera svårare case, upptäck fel, gör åtgärdsplan och ge tydligt facit/rubric.",
        "allow_blocks": ["case", "scenario", "question", "task"],
        "forbid_blocks": ["info", "theory", "definition", "document"],
        "order": ["case", "scenario", "question", "task"],
        "requirements": {
          "case": {
            "min": 1,
            "max": 1,
            "must_include": ["ansvar", "risk", "konsekvens", "åtgärd"]
          },
          "scenario": { "min": 0, "max": 1 },
          "question": {
            "min": 4,
            "max": 10,
            "allowed_question_types": ["best_choice", "short_answer"],
            "must_include": ["felanalys", "åtgärd", "ansvar"],
            "must_have_answer_key": true,
            "require_rubric": true
          },
          "task": {
            "min": 1,
            "max": 2,
            "must_include": ["åtgärdsplan", "kommunicera risk", "följ upp"]
          }
        },
        "step_guards": {
          "must_include_fault_analysis": true,
          "must_include_responsibility": true
        }
      }
    }
  },

  "validation": {
    "hard_fail_if": [
      { "contains_any": ["Kort teori", "Teori kopplad till ämnet", "Genomgång", "Definition"] },
      { "missing_required_block": "scenario" , "when_step_in": [3, 4] },
      { "missing_required_block": "case", "when_step_is": 5 },
      { "question_without_answer_key": true },
      { "step_outputs_too_similar": true }
    ],
    "notes": [
      "Denna policy är avsiktligt strikt för Kapitel=Tillämpning. Teori ska inte förekomma som fristående block.",
      "Om worker saknar stöd för 'case' kan den mappa 'case' till 'scenario' men måste då öka krav på felanalys+ansvar i questions."
    ]
  }
}

