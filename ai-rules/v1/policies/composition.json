{
  "id": "composition-v1.1",
  "type": "policy-composition",
  "description": "Kompositionspolicy (Kapitel x Steg). Låser tillåtna/förbjudna block, förbjudna fraser, ordning och minikrav. Fail-closed. Start: Introduktion (Steg 1–2) + Tillämpning (Steg 3–5).",
  "failClosed": true,

  "scopes": [
    {
      "when": { "chapter": "introduktion", "stepMin": 1, "stepMax": 2 },

      "allow": {
        "blocks": ["info", "question"],
        "questionKinds": ["mcq_single", "true_false"]
      },

      "forbid": {
        "blocks": ["task", "document", "reflection", "case", "scenario"],
        "phrases": [
          "beskriv hur du tänkte",
          "utför uppgiften",
          "lämna in",
          "mellanled",
          "reflektera",
          "diskutera"
        ]
      },

      "orderRules": {
        "step1_2": ["info", "question"]
      },

      "requirements": {
        "step1": {
          "infoMax": 1,
          "questionMin": 2,
          "questionMustBeAnswerable": true,
          "answerKeyRequired": true,
          "questionMustIncludeAny": ["tydlig", "otydlig", "budskap", "missförstånd"]
        },
        "step2": {
          "infoMax": 1,
          "questionMin": 3,
          "answerKeyRequired": true,
          "questionMustIncludeAny": ["tydlig", "otydlig", "kanal", "ton", "bekräfta"]
        }
      }
    },

    {
      "when": { "chapter": "tillämpning", "stepMin": 3, "stepMax": 5 },

      "allow": {
        "blocks": ["scenario", "question", "task", "case"],
        "questionKinds": ["mcq_single", "short_answer"]
      },

      "forbid": {
        "blocks": ["info", "document", "reflection"],
        "phrases": [
          "teorin du nyss",
          "teorin du just",
          "kort teori",
          "sammanfatta",
          "huvudpoäng",
          "genomgång",
          "vad är den viktigaste poängen i teorin",
          "viktigaste poängen i teorin"
        ]
      },

      "orderRules": {
        "step3_4": ["scenario", "question"],
        "step5": ["case", "question"]
      },

      "requirements": {
        "step3": {
          "scenarioMin": 1,
          "scenarioMustIncludeAny": ["kund", "kollega"],
          "questionMin": 2,
          "answerKeyRequired": true
        },
        "step4": {
          "scenarioMin": 1,
          "questionMin": 3,
          "questionMustIncludeAny": ["varför", "felorsak", "förbättra"],
          "answerKeyRequired": true
        },
        "step5": {
          "caseMin": 1,
          "questionMin": 4,
          "rubricRequiredForShortAnswer": true,
          "answerKeyRequired": true
        }
      }
    }
  ],

  "changeLog": [
    "v1.1: Lagt till Kapitel=Introduktion Steg 1–2: endast info+bedömbara frågor (MCQ/TF), förbjuder öppna 'beskriv hur du tänkte'-uppgifter och 'lämna in'-mallar.",
    "v1.1: Behåller Kapitel=Tillämpning Steg 3–5: scenario/case först, förbjuder teori-referenser, kräver facit."
  ]
}
