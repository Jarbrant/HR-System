{
  "id": "composition-v1.2",
  "type": "policy-composition",
  "description": "Kompositionspolicy (Kapitel x Steg). Låser tillåtna/förbjudna block, förbjudna fraser, ordning och minikrav. Fail-closed. Utökad: Grundläggande färdighet (Steg 1–5) för att stoppa 'Kort teori'-fallback och säkra progression.",
  "failClosed": true,

  "scopes": [
    {
      "when": { "chapter": "introduktion", "stepMin": 1, "stepMax": 2 },

      "allow": {
        "blocks": ["info", "question"],
        "questionKinds": ["mcq_single", "true_false"]
      },

      "forbid": {
        "blocks": ["task", "document", "reflection", "case", "scenario"],
        "phrases": [
          "beskriv hur du tänkte",
          "utför uppgiften",
          "lämna in",
          "mellanled",
          "reflektera",
          "diskutera"
        ]
      },

      "orderRules": {
        "step1_2": ["info", "question"]
      },

      "requirements": {
        "step1": {
          "infoMax": 1,
          "questionMin": 2,
          "questionMustBeAnswerable": true,
          "answerKeyRequired": true,
          "questionMustIncludeAny": ["tydlig", "otydlig", "budskap", "missförstånd"]
        },
        "step2": {
          "infoMax": 1,
          "questionMin": 3,
          "answerKeyRequired": true,
          "questionMustIncludeAny": ["tydlig", "otydlig", "kanal", "ton", "bekräfta"]
        }
      }
    },

    {
      "when": { "chapter": "tillämpning", "stepMin": 3, "stepMax": 5 },

      "allow": {
        "blocks": ["scenario", "question", "task", "case"],
        "questionKinds": ["mcq_single", "short_answer"]
      },

      "forbid": {
        "blocks": ["info", "document", "reflection"],
        "phrases": [
          "teorin du nyss",
          "teorin du just",
          "kort teori",
          "sammanfatta",
          "huvudpoäng",
          "genomgång",
          "vad är den viktigaste poängen i teorin",
          "viktigaste poängen i teorin"
        ]
      },

      "orderRules": {
        "step3_4": ["scenario", "question"],
        "step5": ["case", "question"]
      },

      "requirements": {
        "step3": {
          "scenarioMin": 1,
          "scenarioMustIncludeAny": ["kund", "kollega"],
          "questionMin": 2,
          "answerKeyRequired": true
        },
        "step4": {
          "scenarioMin": 1,
          "questionMin": 3,
          "questionMustIncludeAny": ["varför", "felorsak", "förbättra"],
          "answerKeyRequired": true
        },
        "step5": {
          "caseMin": 1,
          "questionMin": 4,
          "rubricRequiredForShortAnswer": true,
          "answerKeyRequired": true
        }
      }
    },

    {
      "when": { "chapter": "grundläggande färdighet", "stepMin": 1, "stepMax": 3 },

      "allow": {
        "blocks": ["info", "question", "task"],
        "questionKinds": ["mcq_single", "true_false", "short_answer"]
      },

      "forbid": {
        "blocks": ["document", "reflection", "case", "scenario"],
        "phrases": [
          "kort teori",
          "sammanfatta",
          "huvudpoäng",
          "genomgång",
          "beskriv hur du tänkte",
          "utför uppgiften",
          "lämna in",
          "mellanled"
        ]
      },

      "orderRules": {
        "step1": ["info", "question"],
        "step2": ["info", "question", "task"],
        "step3": ["question", "task", "question"]
      },

      "requirements": {
        "step1": {
          "infoMax": 1,
          "questionMin": 3,
          "questionMustBeAnswerable": true,
          "answerKeyRequired": true,
          "questionMustIncludeAny": ["tydlig", "otydlig", "budskap", "missförstånd"],
          "notes": [
            "Steg 1 = igenkänning. Endast bedömbara frågor (MCQ/TF) med facit.",
            "Info får finnas men får aldrig ersätta frågor."
          ]
        },
        "step2": {
          "infoMax": 1,
          "questionMin": 2,
          "taskMin": 1,
          "answerKeyRequired": true
        },
        "step3": {
          "infoMax": 1,
          "questionMin": 2,
          "taskMin": 1,
          "preferShortAnswerWithRubric": true,
          "answerKeyRequired": true
        }
      }
    },

    {
      "when": { "chapter": "grundläggande färdighet", "stepMin": 4, "stepMax": 5 },

      "allow": {
        "blocks": ["question", "task", "case"],
        "questionKinds": ["mcq_single", "short_answer", "true_false"]
      },

      "forbid": {
        "blocks": ["info", "document", "reflection", "scenario"],
        "phrases": [
          "kort teori",
          "sammanfatta",
          "huvudpoäng",
          "genomgång",
          "beskriv hur du tänkte",
          "utför uppgiften",
          "lämna in",
          "mellanled"
        ]
      },

      "orderRules": {
        "step4": ["case", "question"],
        "step5": ["case", "question", "task"]
      },

      "requirements": {
        "step4": {
          "infoMax": 0,
          "caseMin": 1,
          "caseMustIncludeAny": ["otydlig", "missförstånd", "ton", "kanal", "instruktion"],
          "questionMin": 3,
          "mustIncludeAny": ["varför", "fel", "risk"],
          "preferShortAnswerWithRubric": true,
          "answerKeyRequired": true,
          "notes": [
            "Steg 4 = fördjupa: motivera, hitta fel, resonera kring val.",
            "Beteendefrågor ska vara short_answer med rubric (rättningsbart)."
          ]
        },
        "step5": {
          "infoMax": 0,
          "caseMin": 1,
          "questionMin": 4,
          "rubricRequiredForShortAnswer": true,
          "answerKeyRequired": true
        }
      }
    }
  ],

  "changeLog": [
    "v1.2: Lagt till Kapitel=Grundläggande färdighet Steg 1–3: stoppar 'Kort teori' och kräver minst 3 bedömbara frågor med facit i Steg 1.",
    "v1.2: Lagt till Kapitel=Grundläggande färdighet Steg 4–5: kräver case + felanalys/motivering/risk, förbjuder info-fallback.",
    "v1.2: Behåller befintliga scopes för Introduktion 1–2 och Tillämpning 3–5 oförändrade."
  ]
}
