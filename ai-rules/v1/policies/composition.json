{
  "id": "composition-v1.0",
  "type": "policy-composition",
  "description": "Kompositionspolicy (Kapitel x Steg). Låser tillåtna/förbjudna block, förbjudna fraser, ordning och minikrav. Fail-closed. Start: Kapitel=Tillämpning Steg 3–5.",
  "failClosed": true,

  "scopes": [
    {
      "when": { "chapter": "tillämpning", "stepMin": 3, "stepMax": 5 },

      "allow": {
        "blocks": ["scenario", "question", "task", "case"],
        "questionKinds": ["mcq_single", "short_answer"]
      },

      "forbid": {
        "blocks": ["info", "document", "reflection"],
        "phrases": [
          "teorin du nyss",
          "teorin du just",
          "kort teori",
          "sammanfatta",
          "huvudpoäng",
          "genomgång",
          "vad är den viktigaste poängen i teorin",
          "viktigaste poängen i teorin"
        ]
      },

      "orderRules": {
        "step3_4": ["scenario", "question"],
        "step5": ["case", "question"]
      },

      "requirements": {
        "step3": {
          "scenarioMin": 1,
          "scenarioMustIncludeAny": ["kund", "kollega"],
          "questionMin": 2,
          "answerKeyRequired": true
        },
        "step4": {
          "scenarioMin": 1,
          "questionMin": 3,
          "questionMustIncludeAny": ["varför", "felorsak", "förbättra"],
          "answerKeyRequired": true
        },
        "step5": {
          "caseMin": 1,
          "questionMin": 4,
          "rubricRequiredForShortAnswer": true,
          "answerKeyRequired": true
        }
      }
    }
  ],

  "changeLog": [
    "v1.0: Första kompositionspolicy. Stoppar teori-referenser i Kapitel=Tillämpning Steg 3–5. Kräver scenario/case först och rättningsbart facit."
  ]
}
