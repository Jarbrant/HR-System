{
  "id": "composition-v1.3",
  "type": "policy-composition",
  "description": "Kompositionspolicy (Kapitel x Steg). Låser tillåtna/förbjudna block, förbjudna fraser, ordning och minikrav. Fail-closed. PROV-/UTBILDNINGSNIVÅ: stoppar meta-frågor och kräver teacherKey-kvalitet för rättning.",
  "failClosed": true,

  "globalGuards": {
    "forbidPhrases": [
      "teorin du nyss",
      "teorin du just",
      "texten ovan",
      "stycket ovan",
      "i teorin ovan",
      "enligt teorin ovan",
      "kort teori",
      "sammanfatta",
      "huvudpoäng",
      "genomgång",
      "vad är den viktigaste poängen i teorin",
      "viktigaste poängen i teorin",
      "beskriv med egna ord",
      "reflektera kring"
    ],
    "notes": [
      "Gäller alla scopes: inga hänvisningar till teori/text som inte ingår i samma block.",
      "Gäller alla scopes: stoppar meta-frågor som inte är prov-/rättningsbara."
    ]
  },

  "teacherKeyQuality": {
    "enabled": true,
    "notes": [
      "answerKeyRequired=true räcker inte. TeacherKey ska vara praktiskt rättningsbar.",
      "Detta syncar med formats/question.json v1.3."
    ],
    "questionKinds": {
      "mcq_single": { "mustHave": ["correctChoiceId", "rationale"] },
      "true_false": { "mustHave": ["correctBoolean", "rationale"] },
      "short_answer": { "mustHave": ["rubric", "modelAnswers", "gradingChecklist", "commonMistakes"] },
      "numeric": { "mustHave": ["correctNumber", "workedSolutionSteps"] }
    },
    "shortAnswerSpecial": {
      "rubricRequired": true,
      "requireModelAnswers": true,
      "requireGradingChecklist": true,
      "requireCommonMistakes": true
    }
  },

  "scopes": [
    {
      "when": { "chapter": "introduktion", "stepMin": 1, "stepMax": 2 },

      "allow": {
        "blocks": ["info", "question"],
        "questionKinds": ["mcq_single", "true_false"]
      },

      "forbid": {
        "blocks": ["task", "document", "reflection", "case", "scenario"],
        "phrases": [
          "beskriv hur du tänkte",
          "utför uppgiften",
          "lämna in",
          "mellanled",
          "reflektera",
          "diskutera"
        ]
      },

      "orderRules": {
        "step1_2": ["info", "question"]
      },

      "requirements": {
        "step1": {
          "infoMax": 1,
          "questionMin": 2,
          "questionMustBeAnswerable": true,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true,
          "questionMustIncludeAny": ["tydlig", "otydlig", "budskap", "missförstånd"]
        },
        "step2": {
          "infoMax": 1,
          "questionMin": 3,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true,
          "questionMustIncludeAny": ["tydlig", "otydlig", "kanal", "ton", "bekräfta"]
        }
      }
    },

    {
      "when": { "chapter": "tillämpning", "stepMin": 3, "stepMax": 5 },

      "allow": {
        "blocks": ["scenario", "question", "task", "case"],
        "questionKinds": ["mcq_single", "short_answer"]
      },

      "forbid": {
        "blocks": ["info", "document", "reflection"],
        "phrases": [
          "teorin du nyss",
          "teorin du just",
          "kort teori",
          "sammanfatta",
          "huvudpoäng",
          "genomgång",
          "vad är den viktigaste poängen i teorin",
          "viktigaste poängen i teorin",
          "beskriv med egna ord",
          "reflektera kring"
        ]
      },

      "orderRules": {
        "step3_4": ["scenario", "question"],
        "step5": ["case", "question"]
      },

      "requirements": {
        "step3": {
          "scenarioMin": 1,
          "scenarioMustIncludeAny": ["kund", "kollega"],
          "questionMin": 2,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true
        },
        "step4": {
          "scenarioMin": 1,
          "questionMin": 3,
          "questionMustIncludeAny": ["varför", "felorsak", "förbättra"],
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true
        },
        "step5": {
          "caseMin": 1,
          "questionMin": 4,
          "rubricRequiredForShortAnswer": true,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true
        }
      }
    },

    {
      "when": { "chapter": "grundläggande färdighet", "stepMin": 1, "stepMax": 3 },

      "allow": {
        "blocks": ["info", "question", "task"],
        "questionKinds": ["mcq_single", "true_false", "short_answer"]
      },

      "forbid": {
        "blocks": ["document", "reflection", "case", "scenario"],
        "phrases": [
          "kort teori",
          "sammanfatta",
          "huvudpoäng",
          "genomgång",
          "beskriv med egna ord",
          "reflektera kring",
          "beskriv hur du tänkte",
          "utför uppgiften",
          "lämna in",
          "mellanled"
        ]
      },

      "orderRules": {
        "step1": ["info", "question"],
        "step2": ["info", "question", "task", "question"],
        "step3": ["question", "task", "question"]
      },

      "requirements": {
        "step1": {
          "infoMax": 1,
          "questionMin": 3,
          "questionMustBeAnswerable": true,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true,
          "questionMustIncludeAny": ["tydlig", "otydlig", "budskap", "missförstånd"],
          "notes": [
            "Steg 1 = igenkänning. Endast bedömbara frågor (MCQ/TF) med facit och rationale.",
            "Info får finnas men får aldrig ersätta frågor."
          ]
        },
        "step2": {
          "infoMax": 1,
          "questionMin": 2,
          "taskMin": 1,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true,
          "shortAnswerTeacherKeyRequired": true,
          "notes": [
            "Steg 2 = grundfärdighet: minst 1 task + minst 2 frågor.",
            "Om frågetyp=short_answer: kräver rubric + modelAnswers + gradingChecklist + commonMistakes."
          ]
        },
        "step3": {
          "infoMax": 1,
          "questionMin": 2,
          "taskMin": 1,
          "preferShortAnswerWithRubric": true,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true,
          "shortAnswerTeacherKeyRequired": true,
          "notes": [
            "Steg 3 = kombinera: minst 2 frågor + 1 task.",
            "Short_answer är tillåtet men bara om teacherKey är komplett (rubric+exempel+checklista+vanliga fel)."
          ]
        }
      }
    },

    {
      "when": { "chapter": "grundläggande färdighet", "stepMin": 4, "stepMax": 5 },

      "allow": {
        "blocks": ["question", "task", "case"],
        "questionKinds": ["mcq_single", "short_answer", "true_false"]
      },

      "forbid": {
        "blocks": ["info", "document", "reflection", "scenario"],
        "phrases": [
          "kort teori",
          "sammanfatta",
          "huvudpoäng",
          "genomgång",
          "beskriv med egna ord",
          "reflektera kring",
          "beskriv hur du tänkte",
          "utför uppgiften",
          "lämna in",
          "mellanled"
        ]
      },

      "orderRules": {
        "step4": ["case", "question"],
        "step5": ["case", "question", "task"]
      },

      "requirements": {
        "step4": {
          "infoMax": 0,
          "caseMin": 1,
          "caseMustIncludeAny": ["otydlig", "missförstånd", "ton", "kanal", "instruktion"],
          "questionMin": 3,
          "mustIncludeAny": ["varför", "fel", "risk"],
          "preferShortAnswerWithRubric": true,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true,
          "shortAnswerTeacherKeyRequired": true,
          "notes": [
            "Steg 4 = fördjupa: motivera, hitta fel, resonera kring val.",
            "Beteendefrågor ska vara short_answer med komplett teacherKey."
          ]
        },
        "step5": {
          "infoMax": 0,
          "caseMin": 1,
          "questionMin": 4,
          "rubricRequiredForShortAnswer": true,
          "answerKeyRequired": true,
          "answerKeyQualityRequired": true,
          "shortAnswerTeacherKeyRequired": true
        }
      }
    }
  ],

  "changeLog": [
    "v1.3: Lagt till globalGuards: stoppar meta-frågor ('beskriv med egna ord', 'reflektera kring') och hänvisningar till saknad teori.",
    "v1.3: Lagt till teacherKeyQuality: kräver praktiskt rättningsbar answerKey (rationale/modelAnswers/checklist/mistakes/steps).",
    "v1.3: Fixat Grundläggande färdighet Steg 2: ordningsregel ger plats för 2 questions + 1 task (info, question, task, question).",
    "v1.3: Skärpt Steg 2–5: short_answer kräver komplett teacherKey (inte bara rubric).",
    "v1.2: Tidigare version med kapitel Grundläggande färdighet 1–5."
  ]
}
