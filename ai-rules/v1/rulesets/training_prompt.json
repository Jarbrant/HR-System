{
  "version": "ai-rules/v1",
  "type": "ruleset",
  "name": "training_prompt",
  "updatedAt": "2026-01-26",
  "purpose": [
    "Styr exakt payload från UI till Worker för AI-generering.",
    "Säkrar målbild: modul -> område -> kapitel -> steg -> difficulty.",
    "Gör output deterministiskt: blocks eller questions enligt formatfiler.",
    "Tvingar variation + unikhet så att AI inte skapar samma fråga i flera items."
  ],
  "constraints": {
    "noPII": true,
    "maxPayloadKb": 64,
    "logPolicy": "never_log_payload",
    "difficultyAllowed": ["intro", "normal", "advanced"],
    "stepAllowed": ["1", "2", "3", "4", "5"],
    "contentTypeAllowed": ["training_blocks", "document", "questions"]
  },

  "questionQuality": {
    "general": {
      "forbidContextPlaceholderText": true,
      "forbiddenPhrases": [
        "Använd detta sammanhang",
        "Utgå från detta sammanhang",
        "(kontext dolt)",
        "[object Object]"
      ],
      "requireExplanation": true,
      "explanationMinChars": 40,

      "batchUniqueness": {
        "enabled": true,
        "mustBeUniqueAcrossItems": [
          "stem_semantic",
          "correct_answer_semantic",
          "scenario_semantic"
        ],
        "forbidNearDuplicateThreshold": 0.85,
        "notes": [
          "Inga två frågor i samma batch får ha samma frågestam med bara små omformuleringar.",
          "Inga två frågor i samma batch får ha samma korrekta svar för samma scenario.",
          "Variera scenario: plats/roll/händelse ska skifta mellan frågor."
        ]
      },

      "variationPlan": {
        "enabled": true,
        "rotateDimensions": [
          "definition_or_concept",
          "routine_first_step",
          "risk_consequence",
          "scenario_application",
          "roles_and_responsibility",
          "deviation_and_action"
        ],
        "minimumDistinctDimensionsInBatch": 3,
        "notes": [
          "När count > 1: fördela frågorna över flera dimensioner.",
          "Undvik att alla frågor hamnar i samma typ (t.ex. bara 'första åtgärden')."
        ]
      }
    },

    "mcq": {
      "minOptions": 4,
      "maxOptions": 6,
      "requireCorrectIndex": true,
      "requirePlausibleDistractors": true,
      "avoidObviousCorrect": true,

      "stemMustDisambiguate": {
        "mustSpecifySituationScope": true,
        "mustAvoidAmbiguousAllCorrect": true,
        "examples": [
          "I en vardagssituation (inte akut) när du vill starta rätt rutin – vad gör du först?",
          "När målet är att få in korrekt information innan åtgärd – vad är första steget?",
          "När du följer en fastställd rutin och ska välja första steget – vilket alternativ stämmer bäst?"
        ],
        "antiExamples": [
          "Vad är den bästa första åtgärden?",
          "Vilket är bäst?",
          "Vad gör du?"
        ]
      },

      "optionCraft": {
        "requireAllOptionsReasonableButOneBest": true,
        "avoidTrickOptions": true,
        "avoidAbsoluteWords": ["alltid", "aldrig", "garanterat"],
        "notes": [
          "Alla alternativ ska kunna kännas rimliga, men frågan ska vara avgränsad så att ett alternativ är bäst i just den situationen.",
          "Distraktorer ska vara plausibla men sämre givet situationens scope."
        ]
      }
    },

    "trueFalse": {
      "enabled": true,
      "rule": "Påståendet ska vara tydligt sant eller tydligt falskt utan gråzoner."
    },

    "numeric": {
      "enabled": true,
      "rule": "Endast när ett numeriskt svar är naturligt (t.ex. temperaturgräns, tid, antal)."
    },

    "shortAnswer": {
      "enabled": true,
      "rule": "Endast när kort fritext kan bedömas med enkel modell (nyckelord) eller manuell granskning."
    }
  },

  "input": {
    "required": ["requestId", "contentType", "count", "language", "context", "output"],
    "properties": {
      "requestId": { "type": "string", "description": "UI genererar req_..." },

      "contentType": {
        "type": "string",
        "enum": ["training_blocks", "document", "questions"],
        "description": "Vad AI ska skapa."
      },

      "count": {
        "type": "number",
        "minimum": 1,
        "maximum": 12,
        "description": "Antal block eller antal frågor."
      },

      "language": {
        "type": "string",
        "enum": ["sv-SE"],
        "default": "sv-SE"
      },

      "context": {
        "type": "object",
        "required": ["catalogRef", "moduleId", "areaId", "chapterId", "step", "difficulty"],
        "properties": {
          "catalogRef": {
            "type": "string",
            "enum": ["ai-rules/v1/modules.json"],
            "description": "Vilken katalog som gäller."
          },
          "moduleId": { "type": "string" },
          "areaId": { "type": "string" },
          "chapterId": { "type": "string" },
          "step": { "type": "string", "enum": ["1", "2", "3", "4", "5"] },
          "difficulty": { "type": "string", "enum": ["intro", "normal", "advanced"] },

          "chapterLabel": { "type": "string", "description": "Valfri för UI-läsbarhet." },
          "areaLabel": { "type": "string", "description": "Valfri för UI-läsbarhet." },
          "moduleLabel": { "type": "string", "description": "Valfri för UI-läsbarhet." }
        }
      },

      "output": {
        "type": "object",
        "required": ["formatRef"],
        "properties": {
          "formatRef": {
            "type": "string",
            "enum": [
              "ai-rules/v1/formats/block.json",
              "ai-rules/v1/formats/question.json"
            ]
          },
          "questionType": {
            "type": "string",
            "enum": ["auto", "mcq_single", "mcq_multi", "true_false", "numeric", "short_answer"],
            "default": "auto",
            "description": "Gäller bara contentType='questions'."
          },
          "feedbackEnabled": {
            "type": "boolean",
            "default": false,
            "description": "Om AI ska inkludera feedback per fråga."
          }
        }
      },

      "trainingMeta": {
        "type": "object",
        "description": "Valfritt: UI kan skicka måltext som extra kontext.",
        "properties": {
          "goalsText": { "type": "string", "maxLength": 2000 },
          "titleHint": { "type": "string", "maxLength": 200 }
        }
      }
    }
  },

  "output": {
    "description": "Worker returnerar payload i exakt formatRef (block.json eller question.json).",
    "successEnvelope": {
      "required": ["ok", "requestId", "items"],
      "properties": {
        "ok": { "type": "boolean", "enum": [true] },
        "requestId": { "type": "string" },
        "items": { "type": "array", "description": "Array av blocks eller questions enligt formatRef." }
      }
    },
    "errorEnvelope": {
      "required": ["ok", "requestId", "errorCode"],
      "properties": {
        "ok": { "type": "boolean", "enum": [false] },
        "requestId": { "type": "string" },
        "errorCode": {
          "type": "string",
          "enum": [
            "VALIDATION_FAILED",
            "MISSING_CONTEXT",
            "UNSUPPORTED_TYPE",
            "PAYLOAD_TOO_LARGE",
            "INTERNAL_ERROR"
          ]
        }
      }
    }
  },

  "examples": [
    {
      "requestId": "req_demo_001",
      "contentType": "questions",
      "count": 5,
      "language": "sv-SE",
      "context": {
        "catalogRef": "ai-rules/v1/modules.json",
        "moduleId": "mod_quality",
        "areaId": "ar_deviation",
        "chapterId": "ch_4_scenario",
        "step": "2",
        "difficulty": "normal",
        "moduleLabel": "Kvalitet",
        "areaLabel": "Avvikelsehantering",
        "chapterLabel": "Scenario & tillämpning"
      },
      "output": {
        "formatRef": "ai-rules/v1/formats/question.json",
        "questionType": "auto",
        "feedbackEnabled": true
      },
      "trainingMeta": {
        "goalsText": "- Förstå vad en avvikelse är.\n- Veta när och hur den ska registreras.",
        "titleHint": "Scenario • Kurs 2 • Avvikelsehantering"
      }
    }
  ]
}
