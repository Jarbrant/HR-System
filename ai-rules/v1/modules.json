{
  "id": "modules-v1.0",
  "type": "module-catalog",
  "description": "Låst katalog för admin/trainings.html: Moduler → Områden → subject. Styr vilka val som finns och exakt vilken subject-regel som ska användas.",

  "uiContract": {
    "moduleSelect": {
      "label": "Modul",
      "valueField": "moduleId",
      "displayField": "label",
      "required": true
    },
    "areaSelect": {
      "label": "Område",
      "valueField": "areaId",
      "displayField": "label",
      "required": true,
      "dependsOn": "moduleId"
    },
    "resolution": {
      "rule": "area.subjectId är alltid source of truth",
      "must": [
        "UI ska skicka subjectId till worker (inte modulnamn).",
        "subjectId måste matcha en fil i /ai-rules/v1/subjects/*.json."
      ]
    },
    "guards": {
      "failClosed": true,
      "notes": [
        "Om moduleId/areaId saknas eller inte hittas → blockera generering.",
        "Generic får bara användas om area.subjectId explicit är 'generic'."
      ]
    }
  },

