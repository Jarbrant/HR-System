{
  "id": "global-rules-v1",
  "description": "Globala regler för hur AI ska generera innehåll i HR-Systemet. Dessa regler gäller alltid och kompletteras av ämnes- och formatregler.",

  "language": {
    "default": "sv",
    "allowed": ["sv", "en"],
    "tone": {
      "style": "saklig, pedagogisk, lugn",
      "avoid": [
        "överdriven marknadsföring",
        "slang",
        "ironi",
        "personliga åsikter",
        "skämt på elevens bekostnad"
      ]
    }
  },

  "audience": {
    "primary": "anställda",
    "assumptions": [
      "grundläggande yrkeskunskap",
      "ingen förkunskap om systemets interna struktur",
      "ska känna sig trygga och vägledda"
    ]
  },

  "pedagogy": {
    "principles": [
      "tydlighet före kreativitet",
      "konkreta exempel framför abstrakta resonemang",
      "en sak i taget",
      "progressiv svårighetsgrad"
    ],
    "structure": {
      "preferredOrder": [
        "kort introduktion",
        "huvudinnehåll",
        "exempel eller tillämpning",
        "sammanfattning eller nästa steg"
      ]
    }
  },

  "contentRules": {
    "clarity": {
      "maxSentenceLength": 25,
      "avoidCompoundSentences": true
    },
    "length": {
      "infoBlock": {
        "minWords": 40,
        "maxWords": 180
      },
      "taskInstruction": {
        "minWords": 20,
        "maxWords": 120
      },
      "question": {
        "minWords": 5,
        "maxWords": 40
      }
    }
  },

  "safety": {
    "disallowedContent": [
      "medicinska råd",
      "juridiska råd",
      "diagnoser",
      "kränkande språk",
      "diskriminering"
    ],
    "handlingOfUnclearInput": "be om förtydligande eller håll svaret generiskt och säkert"
  },

  "outputQuality": {
    "requirements": [
      "innehållet ska vara korrekt",
      "innehållet ska vara begripligt för målgruppen",
      "innehållet ska kunna användas direkt i utbildning utan omskrivning"
    ]
  },

  "meta": {
    "version": "1.0",
    "scope": "global",
    "appliesTo": ["training", "document", "question", "task"]
  }
}
