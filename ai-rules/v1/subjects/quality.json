{
  "id": "subject-quality-v1.0",
  "subject": "quality",
  "description": "Ämnesregler för kvalitet och process. Fokus på faktabaserade, entydiga och rättningsbara frågor om rutiner, avvikelsehantering, förbättring och dokumentstyrning. Ingen juridisk rådgivning.",

  "scope": {
    "allowedKinds": ["mcq_single", "true_false", "short_answer"],
    "notes": [
      "Endast policy- och processbaserade frågor.",
      "Short_answer kräver rubric (3–5 kriterier).",
      "Inga öppna resonemang utan facit."
    ]
  },

  "globalQuality": {
    "must": [
      "Frågan ska vara entydig och kunna besvaras utan externa källor.",
      "Språk: kort, sakligt provspråk.",
      "Svar ska vara rättningsbart enligt answerKey."
    ],
    "avoid": [
      "juridiska tolkningar",
      "personliga åsikter",
      "meta-text om AI eller processen"
    ]
  },

  "difficultyRules": {
    "scale": [1, 2, 3, 4],
    "definition": {
      "1": "Grund: definitioner (avvikelse, rutin, dokument).",
      "2": "Tillämpning: välja korrekt åtgärd i tydligt scenario.",
      "3": "Prioritering: flera alternativ, entydigt rätt enligt process.",
      "4": "Avancerat men entydigt: kombinerar avvikelse → orsak → åtgärd."
    }
  },

  "allowedTopics": [
    "avvikelsehantering",
    "orsaksanalys (grund)",
    "förbättringsåtgärder",
    "processer och rutiner",
    "dokumentstyrning",
    "ändringshantering (grund)",
    "uppföljning och mätetal (grund)"
  ],

  "forbiddenTopics": [
    "öppna förbättringsdiskussioner utan facit",
    "juridisk tolkning av standarder",
    "bedömning av individer"
  ],

  "kindRules": {
    "mcq_single": {
      "useCases": [
        "välj korrekt åtgärd vid avvikelse",
        "välj korrekt definition",
        "välj korrekt nästa steg i processen"
      ],
      "must": [
        "3–5 alternativ, tydligt olika.",
        "Exakt ett korrekt svar.",
        "Distraktorer ska vara realistiska processfel."
      ],
      "explanation": {
        "recommended": true,
        "maxSentences": 4,
        "style": "kort varför enligt process"
      }
    },

    "true_false": {
      "useCases": [
        "grundprinciper (sant/falskt)",
        "tydliga processregler"
      ],
      "must": [
        "Påståendet ska vara objektivt sant eller falskt."
      ],
      "explanation": {
        "required": true,
        "maxSentences": 3
      }
    },

    "short_answer": {
      "useCases": [
        "kort definition",
        "ange korrekt första åtgärd",
        "beskriv enkel förbättringsåtgärd i 1–2 meningar"
      ],
      "must": [
        "Tydliga ramar (max 1–2 meningar).",
        "Rubric krävs (3–5 mätbara kriterier)."
      ],
      "rubricTemplates": {
        "deviation_basic": [
          "Identifierar avvikelsen tydligt",
          "Anger korrekt första åtgärd",
          "Neutral och saklig formulering"
        ],
        "cause_action_basic": [
          "Anger sannolik orsak",
          "Anger relevant åtgärd",
          "Kopplar åtgärd till förebyggande effekt"
        ]
      },
      "explanation": {
        "required": true,
        "maxSentences": 4,
        "style": "förklarar bedömningskriterier"
      }
    }
  },

  "exampleGood": [
    {
      "kind": "mcq_single",
      "difficulty": 2,
      "title": "Avvikelse – första steg",
      "question": "En rutin följs inte i verksamheten. Vad är korrekt första steg i kvalitetsarbetet?",
      "choices": [
        { "id": "A", "label": "Ignorera tills problem uppstår" },
        { "id": "B", "label": "Registrera avvikelsen och analysera orsaken" },
        { "id": "C", "label": "Ändra rutinen direkt utan analys" }
      ],
      "answerKey": { "kind": "mcq_single", "correctChoiceId": "B" },
      "explanation": "Avvikelser ska registreras och analyseras innan åtgärd beslutas."
    },
    {
      "kind": "true_false",
      "difficulty": 1,
      "title": "Dokumentstyrning",
      "question": "Endast gällande version av ett dokument ska användas i verksamheten.",
      "answerKey": { "kind": "true_false", "correctBoolean": true },
      "explanation": "Dokumentstyrning säkerställer att rätt version används."
    }
  ],

  "exampleBad": [
    {
      "reason": "Öppen diskussion utan facit.",
      "question": "Hur tycker du att kvalitetsarbetet kan bli bättre?"
    }
  ],

  "changeLog": [
    "v1.0: Första ämnesregler för kvalitet och process med fokus på avvikelse, åtgärd och dokumentstyrning."
  ]
}

