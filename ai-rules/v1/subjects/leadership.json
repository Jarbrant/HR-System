{
  "type": "subject",
  "subjectId": "leadership",
  "label": "Ledarskap",
  "language": "sv",
  "version": "v1.0.0",
  "status": "active",

  "scope": {
    "purpose": "Skapa sammanhängande utbildningsinnehåll i ledarskap med tydlig progression (steg 1–5) och kvalitetssäkring per blocktyp.",
    "inBounds": [
      "Praktiskt ledarskap i arbetsvardagen",
      "Coachning som metod: mål, frågor, feedback, uppföljning",
      "Kommunikation och struktur i samtal",
      "Etik och respektfullt bemötande",
      "Övningar, scenarier, kunskapsfrågor och korta dokument"
    ],
    "outOfBounds": [
      "Terapi, diagnoser, medicinska råd",
      "Privata relationer eller personlig livscoaching",
      "Juridisk rådgivning",
      "Bedömning av individers psyke eller personlighetsdiagnostik",
      "Känslig persondata eller identifierande uppgifter"
    ],
    "tone": {
      "style": "Klassrumsspråk: tydligt, konkret, lågmält, professionellt",
      "avoid": [
        "manipulativa formuleringar",
        "moraliserande skam",
        "onödigt hårt språk"
      ]
    }
  },

  "areas": [
    {
      "areaId": "coaching",
      "label": "Coachning",
      "goal": "Ge chefer/ledare en praktisk, stegvis förmåga att coacha: sätta mål, ställa frågor, ge feedback, följa upp och hantera motstånd.",
      "targetAudience": [
        "Teamledare",
        "Arbetsledare",
        "Butikschef/skiftledare",
        "Nya chefer"
      ],

      "learningOutcomes": [
        "Förklara vad coachning är och när den används",
        "Genomföra ett kort coachande samtal med struktur",
        "Formulera mål och nästa steg tillsammans med medarbetare",
        "Ge feedback som är tydlig, respektfull och användbar",
        "Följa upp och säkra att åtaganden blir gjorda"
      ],

      "keywords": {
        "prefer": [
          "mål",
          "nästa steg",
          "frågor",
          "lyssna",
          "återkoppling",
          "överenskommelse",
          "uppföljning",
          "sammanfatta"
        ],
        "avoid": [
          "diagnos",
          "terapi",
          "personlighetsstörning",
          "du är sådan",
          "alltid/ingen gång (om det blir skuldbeläggande)"
        ]
      },

      "progression": {
        "steps": [
          {
            "stepId": "1",
            "label": "Kurs 1",
            "focus": "Grunder: vad coachning är, syfte, enkel struktur",
            "expectedBlocks": {
              "info": 1,
              "question": 1,
              "task": 1,
              "reflection": 0,
              "document": 0
            },
            "qualityNotes": [
              "Enkla frågor med tydliga svarsalternativ",
              "Korta uppgifter som går att göra direkt"
            ]
          },
          {
            "stepId": "2",
            "label": "Kurs 2",
            "focus": "Verktyg: coachande frågor, lyssnande, sammanfattning",
            "expectedBlocks": {
              "info": 1,
              "question": 1,
              "task": 1,
              "reflection": 1,
              "document": 0
            },
            "qualityNotes": [
              "Minst ett exempel på bra frågor",
              "Reflektion med tydlig instruktion och exempel"
            ]
          },
          {
            "stepId": "3",
            "label": "Kurs 3",
            "focus": "Tillämpning: scenario + plan + överenskommelse",
            "expectedBlocks": {
              "info": 0,
              "question": 1,
              "task": 2,
              "reflection": 1,
              "document": 0
            },
            "qualityNotes": [
              "Scenario ska kännas verkligt (jobbvardag)",
              "Uppgift ska ha checklista/bedömning"
            ]
          },
          {
            "stepId": "4",
            "label": "Kurs 4",
            "focus": "Svårare lägen: motstånd, otydliga mål, uppföljning",
            "expectedBlocks": {
              "info": 0,
              "question": 2,
              "task": 2,
              "reflection": 1,
              "document": 1
            },
            "qualityNotes": [
              "Minst ett dokument (kort rutin/mall)",
              "Frågor kan vara mer nyanserade men alltid med facit"
            ]
          },
          {
            "stepId": "5",
            "label": "Kurs 5",
            "focus": "Kvalitetssäkring: konsekvent metod, mätbar uppföljning, förbättring",
            "expectedBlocks": {
              "info": 0,
              "question": 2,
              "task": 2,
              "reflection": 1,
              "document": 1
            },
            "qualityNotes": [
              "Inkludera mätpunkt/KPI-förslag i uppföljning",
              "Scenario ska ha tydligt mål + uppföljningsplan"
            ]
          }
        ]
      },

      "chapterGuidance": [
        {
          "chapterLabel": "Introduktion",
          "intent": "Skapa trygg start: begrepp, syfte, när coachning passar.",
          "preferredBlockTypes": ["info", "question", "task"]
        },
        {
          "chapterLabel": "Grundläggande",
          "intent": "Bygg verktyg: frågor, lyssnande, sammanfattning, mål.",
          "preferredBlockTypes": ["info", "question", "task", "reflection"]
        },
        {
          "chapterLabel": "Scenario & tillämpning",
          "intent": "Jobbnära scenarier där eleven tränar samtal och plan.",
          "preferredBlockTypes": ["task", "question", "reflection"]
        },
        {
          "chapterLabel": "Avvikelser & risk",
          "intent": "Vanliga fallgropar: otydliga mål, missförstånd, motstånd. Hur säkrar vi kvalitet i samtalet?",
          "preferredBlockTypes": ["question", "task", "document"]
        },
        {
          "chapterLabel": "Fördjupning",
          "intent": "Mer nyanserad coachning, uppföljning, beteendeförändring i vardagen.",
          "preferredBlockTypes": ["task", "question", "document", "reflection"]
        }
      ],

      "outputRequirements": {
        "global": {
          "mustBeDeterministic": true,
          "noSensitiveData": true,
          "language": "sv"
        },
        "question": {
          "mustInclude": ["question", "options", "correctIndex", "explanation"],
          "optionsMin": 3,
          "optionsMax": 6,
          "correctIndexRule": "0-based",
          "explanationRule": "Kort, tydlig motivering. Ingen moraliserande ton."
        },
        "task": {
          "mustInclude": ["instruction", "deliverable", "checklist"],
          "checklistMin": 3,
          "deliverableExamples": [
            "Skriv 3 coachande frågor",
            "Gör en kort samtalsplan (5–7 meningar)",
            "Formulera mål + nästa steg + uppföljningsdatum"
          ]
        },
        "document": {
          "mustInclude": ["title", "body"],
          "maxLengthChars": 1800,
          "optionalAddons": ["controlQuestions"]
        },
        "reflection": {
          "mustInclude": ["prompt", "exampleGoodAnswer"],
          "maxLengthChars": 800
        }
      },

      "qualityAssurance": {
        "checklist": [
          "Är progressionen tydlig för valt steg (1–5)?",
          "Matchar blocktypen sin struktur (question/task/document/reflection)?",
          "Har frågor svarsalternativ + facit + förklaring?",
          "Är scenarier jobbnära och respektfulla?",
          "Finns minst en mätpunkt/uppföljning från steg 3 och uppåt?"
        ],
        "failClosedRule": "Om kraven inte kan uppfyllas ska output bli en tydlig 'cannot_generate' med orsak (inte halvfärdigt innehåll)."
      }
    }
  ]
}

