{
  "id": "subject-generic-v1.0",
  "subject": "generic",
  "description": "Fallback-ämne för allmänna, neutrala och rättningsbara frågor när inget specifikt ämne är valt. Får aldrig användas för regelstyrda eller riskkänsliga områden.",

  "scope": {
    "allowedKinds": ["mcq_single", "true_false", "short_answer"],
    "notes": [
      "Generic är endast till för allmänna och ofarliga kunskapsfrågor.",
      "Om ett ämne kan mappas till math, swedish, hr_policy, safety etc. ska generic INTE användas."
    ]
  },

  "globalQuality": {
    "must": [
      "Frågan ska vara entydig och rättningsbar.",
      "Språk: kort, neutralt och sakligt.",
      "Svaret ska kunna bedömas utan tolkning."
    ],
    "avoid": [
      "policy- eller regelreferenser",
      "juridiska eller etiska bedömningar",
      "säkerhetsinstruktioner",
      "meta-text om AI eller processen"
    ]
  },

  "allowedTopics": [
    "allmän förståelse",
    "enkla definitioner",
    "grundläggande begrepp",
    "tydliga instruktioner (icke-risk)",
    "struktur och ordning",
    "enkla fakta utan konsekvensrisk"
  ],

  "forbiddenTopics": [
    "matematik",
    "språkbedömning (svenska)",
    "arbetsmiljö",
    "säkerhet eller informationssäkerhet",
    "HR-policy",
    "etik och bemötande",
    "juridik eller regelverk",
    "hälsa eller medicin"
  ],

  "kindRules": {
    "mcq_single": {
      "must": [
        "3–5 tydligt olika alternativ.",
        "Exakt ett korrekt svar."
      ],
      "explanation": {
        "recommended": true,
        "maxSentences": 3,
        "style": "kort faktabaserad förklaring"
      }
    },

    "true_false": {
      "must": [
        "Påståendet ska vara objektivt sant eller falskt."
      ],
      "explanation": {
        "required": true,
        "maxSentences": 2
      }
    },

    "short_answer": {
      "must": [
        "Tydliga ramar (max 1–2 meningar).",
        "Rubric krävs med 3–5 mätbara kriterier."
      ],
      "rubricTemplates": {
        "basic_definition": [
          "Korrekt och tydlig definition",
          "Använder enkelt språk",
          "Inga irrelevanta detaljer"
        ],
        "basic_instruction": [
          "Steg eller ordning är tydlig",
          "Kort och sakligt språk",
          "Ingen riskfylld instruktion"
        ]
      },
      "explanation": {
        "required": true,
        "maxSentences": 3,
        "style": "förklarar vad som bedöms"
      }
    }
  },

  "exampleGood": [
    {
      "kind": "mcq_single",
      "difficulty": 1,
      "title": "Struktur",
      "question": "Vilket alternativ beskriver bäst en tydlig instruktion?",
      "choices": [
        { "id": "A", "label": "Gör det sen." },
        { "id": "B", "label": "Gör uppgiften idag före kl 16 och bekräfta när den är klar." },
        { "id": "C", "label": "Fixar du det när du kan?" }
      ],
      "answerKey": { "kind": "mcq_single", "correctChoiceId": "B" },
      "explanation": "B är konkret, tidsatt och tydlig."
    }
  ],

  "exampleBad": [
    {
      "reason": "Regelstyrt ämne.",
      "question": "Vad säger lagen om detta?"
    },
    {
      "reason": "Säkerhetskritisk instruktion.",
      "question": "Hur stänger man av ett brandlarm?"
    }
  ],

  "changeLog": [
    "v1.0: Första version av generic som strikt fallback-ämne utan risk- eller policyinnehåll."
  ]
}

