{
  "id": "subject-information-security-v1.0",
  "subject": "information_security",
  "description": "Ämnesregler för informationssäkerhet. Fokus på faktabaserade, entydiga och rättningsbara frågor om grundläggande säkerhetsrutiner. Ingen juridisk rådgivning. Används tillsammans med formats/format-question.json och formats/question-types.json.",

  "scope": {
    "allowedKinds": ["mcq_single", "true_false", "short_answer"],
    "notes": [
      "Endast grundläggande informationssäkerhet (awareness).",
      "Inga tekniska konfigurationer eller avancerade angreppsscenarier.",
      "Short_answer kräver rubric."
    ]
  },

  "globalQuality": {
    "must": [
      "Frågan ska vara entydig och kunna besvaras utan externa källor.",
      "Fokus på beteenden och rutiner, inte tekniska detaljer.",
      "Språk: kort, sakligt provspråk."
    ],
    "avoid": [
      "juridiska tolkningar",
      "detaljerade tekniska instruktioner",
      "meta-text om AI eller processen"
    ]
  },

  "difficultyRules": {
    "scale": [1, 2, 3, 4],
    "definition": {
      "1": "Grund: lösenord, låsning, enkel phishing-kännedom.",
      "2": "Tillämpning: välja rätt åtgärd i tydligt scenario.",
      "3": "Prioritering: flera alternativ, entydigt rätt beteende.",
      "4": "Avancerat men entydigt: kombinerar risk + åtgärd + rapportering."
    }
  },

  "allowedTopics": [
    "lösenord och konton (grund)",
    "phishing och misstänkta mejl",
    "hantering av personuppgifter (grund)",
    "delning av information",
    "låsa dator och arbetsplats",
    "incidentrapportering (grund)",
    "social engineering (igenkänning)"
  ],

  "forbiddenTopics": [
    "exploateringstekniker",
    "konkreta säkerhetsbrister i system",
    "juridisk rådgivning (GDPR-tolkning)",
    "instruktioner som kan missbrukas"
  ],

  "kindRules": {
    "mcq_single": {
      "useCases": [
        "identifiera säkert beteende",
        "välja rätt åtgärd",
        "känna igen risk"
      ],
      "must": [
        "3–5 alternativ, tydligt olika.",
        "Exakt ett korrekt svar.",
        "Distraktorer ska vara realistiska fel."
      ],
      "explanation": {
        "recommended": true,
        "maxSentences": 4,
        "style": "kort varför enligt säkerhetsprincip"
      }
    },

    "true_false": {
      "useCases": [
        "grundprinciper (sant/falskt)",
        "tydliga regler utan undantag"
      ],
      "must": [
        "Påståendet ska vara objektivt sant eller falskt."
      ],
      "explanation": {
        "required": true,
        "maxSentences": 3
      }
    },

    "short_answer": {
      "useCases": [
        "kort definition",
        "ange korrekt första åtgärd",
        "beskriv säkert beteende i 1–2 meningar"
      ],
      "must": [
        "Tydliga ramar (max 1–2 meningar).",
        "Rubric krävs (3–5 mätbara kriterier)."
      ],
      "rubricTemplates": {
        "phishing_response_basic": [
          "Identifierar att meddelandet är misstänkt",
          "Anger korrekt åtgärd (inte klicka, rapportera)",
          "Neutral och saklig formulering"
        ],
        "password_hygiene_basic": [
          "Anger starkt lösenord eller hantering",
          "Undviker delning",
          "Följer rutin"
        ]
      },
      "explanation": {
        "required": true,
        "maxSentences": 4,
        "style": "förklarar bedömningskriterier"
      }
    }
  },

  "exampleGood": [
    {
      "kind": "mcq_single",
      "difficulty": 2,
      "title": "Phishing – rätt åtgärd",
      "question": "Du får ett mejl som ber dig bekräfta ditt lösenord via en länk. Vad är rätt åtgärd?",
      "choices": [
        { "id": "A", "label": "Klicka på länken och kontrollera" },
        { "id": "B", "label": "Svara och fråga om det är på riktigt" },
        { "id": "C", "label": "Klicka inte, rapportera enligt rutin" }
      ],
      "answerKey": { "kind": "mcq_single", "correctChoiceId": "C" },
      "explanation": "Lösenord ska aldrig bekräftas via länk. Meddelandet ska rapporteras enligt rutin."
    },
    {
      "kind": "true_false",
      "difficulty": 1,
      "title": "Låsning",
      "question": "Datorn ska låsas när du lämnar arbetsplatsen, även för kort tid.",
      "answerKey": { "kind": "true_false", "correctBoolean": true },
      "explanation": "Olåst dator kan leda till obehörig åtkomst."
    }
  ],

  "exampleBad": [
    {
      "reason": "Teknisk instruktion som kan missbrukas.",
      "question": "Hur kan du kringgå tvåfaktorsautentisering?"
    },
    {
      "reason": "Juridisk tolkning.",
      "question": "Är detta ett GDPR-brott enligt lag?"
    }
  ],

  "changeLog": [
    "v1.0: Första ämnesregler för informationssäkerhet med fokus på beteende och grundrutiner."
  ]
}

