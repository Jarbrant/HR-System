{
  "version": "ai-rules/v1",
  "type": "format",
  "name": "training-blocks",
  "schema": "training-blocks.json/v1",
  "updatedAt": "2026-01-20",
  "purpose": [
    "Stabilt AI-output för utbildningar (UI kan rendera utan tolkning).",
    "Byggt för auto-rättning: question-block innehåller endast val/kryss.",
    "Stödjer två lägen: training (frågor/uppgifter) och document (dokument utan prov)."
  ],
  "constraints": {
    "modeAllowed": ["training", "document"],
    "maxBlocks": 12,
    "blockTitleMaxChars": 90,
    "textMaxChars": 1800,
    "noInnerHtml": true,
    "noFreeTextAnswers": true
  },
  "training": {
    "required": [
      "id",
      "mode",
      "subject",
      "difficulty",
      "title",
      "blocks"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Stabilt id för utbildningen.",
        "pattern": "^[a-z0-9_\\-]{6,64}$"
      },
      "mode": {
        "type": "string",
        "enum": ["training", "document"]
      },
      "subject": {
        "type": "object",
        "description": "Frågemotor-koppling (modul/område/kapitel/steg).",
        "required": ["module", "area", "chapter", "step"],
        "properties": {
          "module": { "type": "string", "minLength": 1, "maxLength": 80 },
          "area": { "type": "string", "minLength": 1, "maxLength": 80 },
          "chapter": { "type": "string", "minLength": 1, "maxLength": 80 },
          "step": { "type": "string", "enum": ["1", "2", "3", "4", "5", "6", "7"] }
        }
      },
      "difficulty": {
        "type": "string",
        "description": "Tre nivåer (låst).",
        "enum": ["intro", "normal", "advanced"]
      },
      "title": {
        "type": "string",
        "description": "Visningsrubrik för utbildningen.",
        "minLength": 3,
        "maxLength": 120
      },
      "summary": {
        "type": "string",
        "description": "Kort sammanfattning (valfri).",
        "maxLength": 450
      },
      "objectives": {
        "type": "array",
        "description": "Mål (valfritt) – korta punkter.",
        "maxItems": 8,
        "items": { "type": "string", "maxLength": 140 }
      },
      "blocks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": ["blockId", "kind", "title", "items"],
          "properties": {
            "blockId": {
              "type": "string",
              "description": "Stabilt blockId (kan bli AO-0XX_BLOCKS_V1 id senare).",
              "pattern": "^[a-z0-9_\\-]{6,64}$"
            },
            "kind": {
              "type": "string",
              "description": "Block-typ (låst).",
              "enum": ["info", "task", "question", "document"]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 90
            },
            "items": {
              "type": "array",
              "description": "Renderbara rader. För question-kind: exakt 1 item som är en question.",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["text", "bullets", "callout", "questionRef", "questionInline"]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 1800
                  },
                  "bullets": {
                    "type": "array",
                    "maxItems": 12,
                    "items": { "type": "string", "maxLength": 180 }
                  },
                  "tone": {
                    "type": "string",
                    "description": "UI-hint (ingen logik).",
                    "enum": ["neutral", "warning", "success", "info"]
                  },
                  "questionId": {
                    "type": "string",
                    "description": "Om frågan ligger separat (reference).",
                    "pattern": "^[a-z0-9_\\-]{6,64}$"
                  },
                  "question": {
                    "type": "object",
                    "description": "Inline-fråga enligt ai-rules/v1/formats/question.json.",
                    "additionalProperties": true
                  }
                }
              }
            },
            "scoring": {
              "type": "object",
              "description": "Block-nivå scoring (valfritt).",
              "properties": {
                "points": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      },
      "meta": {
        "type": "object",
        "description": "Spårbarhet utan PII.",
        "properties": {
          "createdAt": { "type": "number" },
          "createdBy": { "type": "string", "maxLength": 64 },
          "source": { "type": "string", "maxLength": 64 }
        }
      }
    }
  },
  "validationRules": [
    {
      "id": "TB01_question_block_shape",
      "when": "block.kind == 'question'",
      "must": "block.items.length == 1 AND (block.items[0].type == 'questionInline' OR block.items[0].type == 'questionRef')"
    },
    {
      "id": "TB02_document_mode_no_question",
      "when": "training.mode == 'document'",
      "must": "no blocks with kind == 'question'"
    }
  ],
  "examples": [
    {
      "training": {
        "id": "tr_demo_coldchain_step1",
        "mode": "training",
        "subject": { "module": "Livsmedel", "area": "Kylkedja", "chapter": "Introduktion", "step": "1" },
        "difficulty": "intro",
        "title": "Kylkedja – Introduktion (Steg 1)",
        "summary": "Grundregler och en kontrollfråga.",
        "objectives": ["Förstå syftet med kylkedjan", "Känna igen rätt temperaturhantering"],
        "blocks": [
          {
            "blockId": "b_info_001",
            "kind": "info",
            "title": "Vad är kylkedjan?",
            "items": [
              { "type": "text", "text": "Kylkedjan handlar om att hålla rätt temperatur hela vägen för att minska risk." }
            ]
          },
          {
            "blockId": "b_q_001",
            "kind": "question",
            "title": "Kontrollfråga",
            "items": [
              {
                "type": "questionInline",
                "question": {
                  "id": "q_coldchain_1",
                  "subject": { "module": "Livsmedel", "area": "Kylkedja", "chapter": "Introduktion", "step": "1" },
                  "difficulty": "intro",
                  "answerMode": "single_choice",
                  "prompt": "Vilket är det viktigaste syftet med kylkedjan?",
                  "options": [
                    { "id": "A", "text": "Att maten håller rätt temperatur för att minska bakterietillväxt" },
                    { "id": "B", "text": "Att packa snabbare" },
                    { "id": "C", "text": "Att minska antalet leveranser" }
                  ],
                  "correctAnswers": ["A"],
                  "rationale": "Rätt temperatur minskar risk för bakterietillväxt.",
                  "scoring": { "points": 1, "negativePoints": 0, "partialCredit": false }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "training": {
        "id": "doc_demo_quality_policy",
        "mode": "document",
        "subject": { "module": "Kvalitet", "area": "ISO 9001", "chapter": "Grundläggande", "step": "1" },
        "difficulty": "intro",
        "title": "ISO 9001 – Grundläggande (Dokument)",
        "blocks": [
          {
            "blockId": "b_doc_001",
            "kind": "document",
            "title": "Översikt",
            "items": [
              { "type": "text", "text": "Detta dokument sammanfattar grunderna i ISO 9001 på enkel nivå." },
              { "type": "bullets", "bullets": ["Syfte", "Roller", "Vanliga krav"], "tone": "neutral" }
            ]
          }
        ]
      }
    }
  ]
}
