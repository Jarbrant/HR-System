{
  "version": "ai-rules/v1",
  "type": "format",
  "name": "result",
  "updatedAt": "2026-01-20",
  "purpose": [
    "Standardformat för elevens (employee) resultat på en utbildning/ett prov.",
    "Maskinläsbart för auto-rättning och manager-översikt.",
    "Ingen persondata utöver employeeId (empNo)."
  ],
  "constraints": {
    "noPII": true,
    "employeeIdField": "empNo",
    "maxAnswers": 200,
    "scoreRange": { "min": 0, "max": 100 },
    "language": "sv-SE",
    "submission": "structured_only"
  },
  "schema": {
    "required": [
      "id",
      "employeeId",
      "trainingId",
      "moduleId",
      "areaId",
      "chapterId",
      "step",
      "difficulty",
      "submittedAt",
      "answers",
      "summary"
    ],
    "properties": {
      "id": { "type": "string", "description": "Unikt result-id (r_...)."},
      "employeeId": { "type": "string", "description": "empNo (ingen annan identitet)." },
      "trainingId": { "type": "string", "description": "Utbildningens id (tr_...)."},
      "moduleId": { "type": "string", "description": "Module id (mod_* från modules.json)." },
      "areaId": { "type": "string", "description": "Area id (ar_* från modules.json)." },
      "chapterId": { "type": "string", "description": "Kapitel id (ch_* från modules.json)." },
      "step": { "type": "string", "enum": ["1", "2", "3", "4", "5"] },
      "difficulty": { "type": "string", "enum": ["intro", "normal", "advanced"] },
      "submittedAt": { "type": "number", "description": "Epoch ms när inlämning skedde." },
      "answers": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "required": ["questionId", "type", "response"],
          "properties": {
            "questionId": { "type": "string", "description": "q_... från question-format." },
            "type": {
              "type": "string",
              "enum": ["mcq_single", "mcq_multi", "true_false", "numeric", "short_answer"]
            },
            "response": {
              "type": "object",
              "description": "Strukturerat svar beroende på typ."
            },
            "autoScore": {
              "type": "object",
              "description": "Valfritt: resultat per fråga efter auto-rättning.",
              "required": ["isCorrect"],
              "properties": {
                "isCorrect": { "type": "boolean" },
                "points": { "type": "number" },
                "maxPoints": { "type": "number" },
                "feedback": { "type": "string" }
              }
            }
          }
        }
      },
      "summary": {
        "type": "object",
        "required": ["questionCount", "correctCount", "scorePercent", "needsFollowup"],
        "properties": {
          "questionCount": { "type": "number" },
          "correctCount": { "type": "number" },
          "scorePercent": { "type": "number", "minimum": 0, "maximum": 100 },
          "needsFollowup": { "type": "boolean" },
          "flags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "t.ex. ['critical_mistake', 'low_score']"
          }
        }
      },
      "meta": {
        "type": "object",
        "description": "Valfri metadata, ingen persondata."
      }
    }
  },
  "responseShapes": {
    "mcq_single": {
      "response": { "selectedOptionId": "opt_a" }
    },
    "mcq_multi": {
      "response": { "selectedOptionIds": ["opt_a", "opt_c"] }
    },
    "true_false": {
      "response": { "value": true }
    },
    "numeric": {
      "response": { "value": 12.5, "unit": "" }
    },
    "short_answer": {
      "response": { "value": "kort svar (styrt)", "maxChars": 120 }
    }
  },
  "validationRules": [
    {
      "rule": "no_free_text_by_default",
      "description": "short_answer får användas men ska vara kort, maxChars ska finnas."
    },
    {
      "rule": "answer_types_match_question",
      "description": "type måste matcha frågans type (samma enum)."
    },
    {
      "rule": "score_consistency",
      "description": "scorePercent ska matcha correctCount/questionCount (avrundning ok)."
    }
  ],
  "examples": [
    {
      "id": "r_example_001",
      "employeeId": "EMP-1007",
      "trainingId": "tr_1700000000000_ab12cd",
      "moduleId": "mod_quality",
      "areaId": "ar_deviation",
      "chapterId": "ch_4_scenario",
      "step": "2",
      "difficulty": "normal",
      "submittedAt": 1768867200000,
      "answers": [
        {
          "questionId": "q_example_01",
          "type": "mcq_single",
          "response": { "selectedOptionId": "opt_b" },
          "autoScore": { "isCorrect": true, "points": 1, "maxPoints": 1, "feedback": "Rätt åtgärd i detta scenario." }
        },
        {
          "questionId": "q_example_02",
          "type": "true_false",
          "response": { "value": false },
          "autoScore": { "isCorrect": false, "points": 0, "maxPoints": 1, "feedback": "Fel – kontrollera rutinen för rapportering." }
        }
      ],
      "summary": {
        "questionCount": 2,
        "correctCount": 1,
        "scorePercent": 50,
        "needsFollowup": true,
        "flags": ["low_score"]
      }
    }
  ],
  "uiHints": {
    "employeeView": {
      "showImmediateFeedbackIfPresent": true,
      "showScore": true
    },
    "managerView": {
      "showSummaryTable": true,
      "showFlags": true,
      "filterBy": ["moduleId", "areaId", "chapterId", "step", "difficulty", "employeeId"]
    }
  }
}

