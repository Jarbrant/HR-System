{
  "id": "question-types-v1.0",
  "type": "question-type-catalog",
  "description": "Pedagogisk katalog över tillåtna frågetyper. Används av admin/trainings.html för val av frågetyp och mappas till format-question.json (kind + krav).",

  "uiContract": {
    "select": {
      "label": "Frågetyp",
      "valueField": "typeId",
      "displayField": "label",
      "required": true
    },
    "guards": {
      "failClosed": true,
      "notes": [
        "UI får endast erbjuda typer som är allowed för valt subject.",
        "Om typeId saknas eller inte stöds → blockera generering."
      ]
    }
  },

  "types": [
    {
      "typeId": "mcq_single",
      "label": "Flervalsfråga (ett rätt svar)",
      "description": "Välj ett korrekt alternativ bland flera.",
      "kind": "mcq_single",

      "pedagogicalUse": [
        "faktakunskap",
        "klassificering",
        "rätt/fel-beslut",
        "igenkänning och tillämpning"
      ],

      "requirements": {
        "choices": {
          "min": 3,
          "max": 5,
          "exactlyOneCorrect": true
        },
        "explanation": {
          "requiredWhen": [
            "numeric-in-mcq",
            "meta.tags contains 'math'"
          ]
        }
      },

      "allowedSubjects": [
        "math",
        "swedish",
        "generic",
        "work_environment",
        "information_security",
        "hr_policy",
        "ethics",
        "environment",
        "haccp",
        "swot"
      ]
    },

    {
      "typeId": "true_false",
      "label": "Sant / Falskt",
      "description": "Bedöm om ett påstående är sant eller falskt.",
      "kind": "true_false",

      "pedagogicalUse": [
        "kontroll av grundprinciper",
        "definitioner",
        "regelmedvetenhet"
      ],

      "requirements": {
        "explanation": {
          "alwaysRequired": true,
          "maxSentences": 3
        }
      },

      "allowedSubjects": [
        "math",
        "swedish",
        "generic",
        "work_environment",
        "information_security",
        "hr_policy",
        "ethics",
        "environment",
        "haccp",
        "swot"
      ]
    },

    {
      "typeId": "short_answer",
      "label": "Kortsvar (styrt)",
      "description": "Kort fritextsvar som bedöms med rubric.",
      "kind": "short_answer",

      "pedagogicalUse": [
        "definitioner",
        "kort motivering",
        "förklara begrepp",
        "klassificera och motivera kort"
      ],

      "requirements": {
        "rubric": {
          "required": true,
          "minCriteria": 3,
          "maxCriteria": 5
        },
        "answerLength": {
          "maxSentences": 2
        },
        "explanation": {
          "required": true
        }
      },

      "allowedSubjects": [
        "swedish",
        "generic",
        "work_environment",
        "information_security",
        "hr_policy",
        "ethics",
        "environment",
        "haccp",
        "swot"
      ]
    },

    {
      "typeId": "numeric",
      "label": "Numerisk uppgift",
      "description": "Beräkning med numeriskt facit.",
      "kind": "numeric",

      "pedagogicalUse": [
        "beräkningar",
        "omvandlingar",
        "tid, mängd, temperatur",
        "stegvis problemlösning"
      ],

      "requirements": {
        "correctNumber": {
          "required": true
        },
        "explanation": {
          "alwaysRequired": true
        },
        "workedSteps": {
          "recommended": true,
          "maxSteps": 6
        }
      },

      "allowedSubjects": [
        "math",
        "haccp"
      ]
    }
  ],

  "resolutionRules": {
    "mapping": [
      "typeId → kind → format-question.json",
      "subject.json kan ytterligare begränsa typeId"
    ],
    "conflicts": [
      "Om subject inte tillåter vald typeId → blockera",
      "Om typeId kräver rubric/explanation och dessa saknas → blockera"
    ]
  },

  "changeLog": [
    "v1.0: Första katalog för frågetyper med pedagogisk användning och UI-kontrakt."
  ]
}
