{
  "id": "format-reflection-v1.0",
  "format": "reflection",
  "description": "Formatregler för meta/feedback-block i HR-Systemets utbildningsplattform. Används för återkoppling (upplevelse, tydlighet, förbättringsförslag) och ska inte rättas som provfråga. Ingen rätt/fel-logik.",

  "blockContract": {
    "typeValue": "reflection",
    "requiredFields": ["type", "title", "prompt", "responseSpec"],
    "optionalFields": ["text", "hints", "meta"],
    "fieldRules": {
      "type": { "mustEqual": "reflection" },
      "title": { "minChars": 4, "maxChars": 80 },
      "prompt": { "minChars": 12, "maxChars": 380 },
      "text": { "maxChars": 900 },
      "hints": { "maxItems": 3, "itemMaxChars": 160 },
      "meta": { "mustFollow": "metaRules.shape" }
    },
    "additionalProperties": false,
    "notes": [
      "Reflection-block är för feedback och självskattning – inte prov.",
      "Ingen answerKey får förekomma i reflection."
    ]
  },

  "aiOutputContract": {
    "description": "Kontrakt för vad AI/Workern ska leverera tillbaka till UI för ett enskilt reflection-block.",
    "requiredFields": ["version", "block", "quality"],
    "fieldRules": {
      "version": { "mustEqual": "format-reflection-v1.0" },
      "block": { "mustFollow": "blockContract" },
      "quality": {
        "requiredFields": ["isClear", "noMetaText", "antiGenericOk"],
        "fieldRules": {
          "isClear": { "type": "boolean", "mustEqual": true },
          "noMetaText": { "type": "boolean", "mustEqual": true },
          "antiGenericOk": { "type": "boolean", "mustEqual": true }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "notes": [
      "AI får inte returnera extra toppnivåfält utöver version/block/quality.",
      "Workern ska fail-closed om quality-kraven inte uppfylls."
    ]
  },

  "responseTypes": {
    "allowed": ["free_text", "scale", "multi_select", "single_select"],
    "default": "free_text",
    "notes": [
      "free_text: fri text inom gränser",
      "scale: numerisk skala (t.ex. 1–5) med etiketter",
      "single_select: ett val bland alternativ",
      "multi_select: flera val bland alternativ"
    ]
  },

  "responseSpecContract": {
    "description": "Regler för hur användarens feedback ska samlas in i UI (inte AI-svar).",
    "requiredFieldsByType": {
      "free_text": ["type", "limits"],
      "scale": ["type", "scale", "labels"],
      "single_select": ["type", "options"],
      "multi_select": ["type", "options"]
    },
    "commonOptionalFields": ["placeholder", "helpText", "allowSkip"],
    "rules": {
      "type": { "mustBeOneOf": ["free_text", "scale", "multi_select", "single_select"] },
      "allowSkip": { "default": true },
      "placeholder": { "maxChars": 80 },
      "helpText": { "maxChars": 220 }
    },
    "forbiddenFieldsByType": {
      "free_text": ["scale", "labels", "options"],
      "scale": ["options", "limits"],
      "single_select": ["scale", "labels", "limits"],
      "multi_select": ["scale", "labels", "limits"]
    },
    "additionalProperties": false
  },

  "freeTextRules": {
    "limits": {
      "minChars": 20,
      "maxChars": 350,
      "recommendedChars": [60, 220]
    },
    "quality": [
      "frågan ska efterfråga konkret feedback (inte allmänna tankar)",
      "undvik ledande formuleringar",
      "uppmuntra förbättringsförslag med exempel"
    ]
  },

  "scaleRules": {
    "defaultScale": { "min": 1, "max": 5 },
    "notes": [
      "Scale passar för svårighetsgrad, tydlighet, relevans, trygghet."
    ]
  },

  "selectRules": {
    "options": {
      "minItems": 3,
      "maxItems": 8,
      "itemMaxChars": 48
    },
    "quality": [
      "alternativen ska vara tydligt olika",
      "undvik överlapp (t.ex. två nästan lika alternativ)"
    ]
  },

  "metaRules": {
    "required": false,
    "shape": {
      "mins": { "min": 1, "max": 10, "default": 2 },
      "tags": { "maxItems": 8, "tagMaxChars": 20 }
    }
  },

  "languageToneRules": {
    "must": [
      "Skriv som en enkel feedbackfråga: kort, neutral, tydlig.",
      "Ingen meta-text om AI eller processen.",
      "Fråga efter exempel när det är relevant."
    ],
    "avoidPhrases": [
      "som AI",
      "här är",
      "jag kan inte",
      "det beror på",
      "generellt sett",
      "i de flesta fall",
      "tips:"
    ],
    "notes": [
      "Workern bör kontrollera avoidPhrases i title/prompt/text och regenerera vid träff (antiGenericOk=false)."
    ]
  },

  "generationGuidance": {
    "must": [
      "Reflection ska inte innehålla answerKey eller något som antyder rätt/fel.",
      "Frågan ska vara konkret och lätt att svara på.",
      "Om responseType är scale/select: etiketter/alternativ ska vara korta och tydliga.",
      "Språk ska följa languageToneRules (kort, neutral, sakligt)."
    ],
    "avoid": [
      "bedömningsspråk (rätt/fel, facit, poäng)",
      "långa essä-uppmaningar",
      "ledande frågor (t.ex. 'vad var bäst?') utan balans"
    ]
  },

  "examples": {
    "free_text": {
      "version": "format-reflection-v1.0",
      "block": {
        "type": "reflection",
        "title": "Förbättringsförslag",
        "prompt": "Vad kan vi förtydliga i denna utbildning för att göra den enklare att följa? Ge gärna ett konkret exempel.",
        "responseSpec": {
          "type": "free_text",
          "limits": { "minChars": 40, "maxChars": 300 },
          "placeholder": "Skriv kort och konkret...",
          "allowSkip": true
        },
        "hints": ["Fokusera på ett moment: instruktion, exempel eller ordval."],
        "meta": { "mins": 2, "tags": ["feedback", "clarity"] }
      },
      "quality": { "isClear": true, "noMetaText": true, "antiGenericOk": true }
    },
    "scale": {
      "version": "format-reflection-v1.0",
      "block": {
        "type": "reflection",
        "title": "Svårighetsgrad",
        "prompt": "Hur upplevde du svårighetsgraden i denna utbildning?",
        "responseSpec": {
          "type": "scale",
          "scale": { "min": 1, "max": 5 },
          "labels": {
            "1": "Mycket lätt",
            "2": "Lätt",
            "3": "Lagom",
            "4": "Svår",
            "5": "Mycket svår"
          },
          "allowSkip": true
        },
        "meta": { "mins": 1, "tags": ["feedback", "difficulty"] }
      },
      "quality": { "isClear": true, "noMetaText": true, "antiGenericOk": true }
    },
    "single_select": {
      "version": "format-reflection-v1.0",
      "block": {
        "type": "reflection",
        "title": "Tydlighet",
        "prompt": "Vilken del var mest otydlig?",
        "responseSpec": {
          "type": "single_select",
          "options": [
            "Instruktionerna",
            "Exemplet",
            "Begreppen",
            "Ordvalet",
            "Svårighetsnivån"
          ],
          "allowSkip": true
        },
        "meta": { "mins": 1, "tags": ["feedback", "clarity"] }
      },
      "quality": { "isClear": true, "noMetaText": true, "antiGenericOk": true }
    },
    "multi_select": {
      "version": "format-reflection-v1.0",
      "block": {
        "type": "reflection",
        "title": "Vad hjälpte mest?",
        "prompt": "Vad hjälpte dig mest att förstå innehållet?",
        "responseSpec": {
          "type": "multi_select",
          "options": [
            "Exempel",
            "Steg-för-steg",
            "Begreppsförklaringar",
            "Kort sammanfattning",
            "Övning efter teori"
          ],
          "allowSkip": true
        },
        "meta": { "mins": 1, "tags": ["feedback", "learning"] }
      },
      "quality": { "isClear": true, "noMetaText": true, "antiGenericOk": true }
    }
  },

  "notes": [
    "Reflection-block kan användas för utvärdering och förbättring av utbildningar utan att blanda ihop med provfrågor.",
    "Workern ska validera att reflection aldrig innehåller answerKey.",
    "UI kan senare lagra svar i en 'pärmen för provresultat' eller feedback-mapp, men detta kontrakt definierar bara blockformatet."
  ],

  "changeLog": [
    "v1.0: Introduced reflection format with responseSpec (free_text/scale/select) and strict no-answerKey rule.",
    "v1.0: Added aiOutputContract and anti-generic languageToneRules."
  ]
}

