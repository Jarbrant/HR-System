{
  "version": "ai-rules/v1",
  "type": "format",
  "name": "task",
  "updatedAt": "2026-01-20",
  "purpose": [
    "Standardformat för uppgifter som kan följas upp utan fri-text-svar.",
    "Låst till checklist-/val-uppgifter så att de kan kvitteras och rapporteras."
  ],
  "constraints": {
    "grading": "completion",
    "allowedTaskKinds": ["checklist", "single_select", "multi_select"],
    "disallowFreeTextSubmission": true,
    "maxInstructionChars": 700,
    "maxItemTextChars": 140,
    "minItems": 1,
    "maxItems": 12,
    "language": "sv-SE",
    "noPII": true
  },
  "schema": {
    "required": [
      "id",
      "kind",
      "title",
      "instruction",
      "items",
      "difficulty",
      "tags"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unikt id för uppgiften (ex t_...)."
      },
      "kind": {
        "type": "string",
        "enum": ["checklist", "single_select", "multi_select"],
        "description": "checklist = bocka av steg. single_select/multi_select = välj alternativ."
      },
      "title": {
        "type": "string",
        "description": "Kort titel för uppgiften."
      },
      "instruction": {
        "type": "string",
        "description": "Kort instruktion. Inga krav på fri text-inlämning."
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "properties": {
            "id": {
              "type": "string",
              "description": "Item-id: 1..12 eller A..L."
            },
            "text": {
              "type": "string",
              "description": "Text för steg/alternativ (max 140 tecken)."
            }
          }
        }
      },
      "answerKey": {
        "type": "object",
        "description": "Valfritt. Används när task är ett val (single/multi) som kan 'rättas'.",
        "properties": {
          "correctItemIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "difficulty": {
        "type": "string",
        "enum": ["intro", "normal", "advanced"]
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" }
      },
      "meta": {
        "type": "object",
        "description": "Valfri metadata, men får inte innehålla persondata."
      }
    }
  },
  "examples": [
    {
      "id": "t_example_001",
      "kind": "checklist",
      "title": "Kylkedja – snabb kontroll",
      "instruction": "Bocka av stegen när de är utförda. Ingen fri text behövs.",
      "items": [
        { "id": "1", "text": "Kontrollera att kylutrymmet är stängt och rent." },
        { "id": "2", "text": "Verifiera temperatur enligt rutin (inom godkänt intervall)." },
        { "id": "3", "text": "Säkra att varor placeras enligt zon (rått/färdigt separerat)." }
      ],
      "difficulty": "intro",
      "tags": ["Livsmedel", "Kylkedja", "kapitel:Introduktion", "steg:1"]
    },
    {
      "id": "t_example_002",
      "kind": "single_select",
      "title": "Avvikelse – rätt första åtgärd",
      "instruction": "Välj det bästa alternativet.",
      "items": [
        { "id": "A", "text": "Ignorera och fortsätt arbetet." },
        { "id": "B", "text": "Stoppa, säkra läget och rapportera avvikelsen enligt rutin." },
        { "id": "C", "text": "Vänta tills någon annan tar ansvar." }
      ],
      "answerKey": { "correctItemIds": ["B"] },
      "difficulty": "normal",
      "tags": ["Kvalitet", "Avvikelse", "kapitel:Tillämpning", "steg:2"]
    }
  ],
  "validationRules": [
    {
      "rule": "items_ids_unique",
      "description": "Alla items[].id måste vara unika."
    },
    {
      "rule": "no_free_text",
      "description": "Inga fält för fri text-inlämning får förekomma."
    },
    {
      "rule": "single_select_answerKey_exactly_one",
      "description": "Om kind=single_select och answerKey finns: correctItemIds ska ha exakt 1 id."
    },
    {
      "rule": "multi_select_answerKey_1_to_6",
      "description": "Om kind=multi_select och answerKey finns: correctItemIds ska ha 1–6 id."
    },
    {
      "rule": "answerKey_subset_of_items",
      "description": "Om answerKey finns: correctItemIds måste finnas i items[].id."
    }
  ],
  "uiHints": {
    "studentAnswerShape": {
      "checklist": { "checkedItemIds": ["1", "2"] },
      "single_select": { "selectedItemId": "B" },
      "multi_select": { "selectedItemIds": ["A", "C"] }
    },
    "teacherReportShape": {
      "taskId": "t_example_001",
      "completed": true,
      "checked": ["1", "2", "3"]
    }
  }
}
