{
  // ============================================================
  // FORMAT: QUESTION
  // VERSION: v1.3
  // PLATS: /ai-rules/v1/formats/format-question.json
  //
  // Syfte:
  // - Definierar exakt vilka provfrågor AI får generera
  // - Säkerställer rättningsbarhet, pedagogik och anti-flum
  // - Låser metodkrav för matematik (numeric + mcq_single + math)
  // ============================================================

  "id": "format-question-v1.3",
  "format": "question",
  "description": "Strikt format för provfrågor i HR-Systemet. v1.3: metodkrav för numeric + MCQ(math), stegvis facit, anti-generic guards.",

  // ------------------------------------------------------------
  // BLOCK-KONTRAKT
  // Detta är själva frågeblocket som UI renderar
  // ------------------------------------------------------------
  "blockContract": {
    "typeValue": "question",

    // Dessa fält MÅSTE alltid finnas
    "requiredFields": ["type", "title", "question", "answerKey"],

    // Dessa fält FÅR förekomma
    "optionalFields": [
      "text",
      "choices",
      "hints",
      "explanation",
      "workedSteps",
      "rubric",
      "figureRef",
      "meta"
    ],

    "fieldRules": {
      "type": { "mustEqual": "question" },

      // Titel ska vara kort och informativ
      "title": { "minChars": 4, "maxChars": 80 },

      // Själva frågan – måste vara entydig
      "question": { "minChars": 20, "maxChars": 500 },

      // Extra kontext (valfritt)
      "text": { "maxChars": 900 },

      // För MCQ
      "choices": { "maxItems": 5 },

      // Pedagogiska hints (ska användas sparsamt)
      "hints": { "maxItems": 3, "itemMaxChars": 160 },

      // Förklaring / metod (krävs i vissa fall, se numericRules)
      "explanation": {
        "minChars": 10,
        "maxChars": 600,
        "maxSentences": 6
      },

      // Steg-för-steg-facit (maskinläsbart)
      "workedSteps": {
        "maxItems": 6,
        "itemMaxChars": 160
      },

      // Bildstöd – ENDAST intern referens
      "figureRef": {
        "maxChars": 80,
        "pattern": "^[a-z0-9_\\-\\.]{3,80}$"
      },

      "meta": { "mustFollow": "metaRules.shape" }
    },

    // 🔒 Mycket viktigt: inga okända fält
    "additionalProperties": false
  },

  // ------------------------------------------------------------
  // AI-OUTPUT-KONTRAKT
  // Det AI + worker MÅSTE returnera till UI
  // ------------------------------------------------------------
  "aiOutputContract": {
    "requiredFields": ["version", "kind", "block", "quality"],

    "fieldRules": {
      "version": { "mustEqual": "format-question-v1.3" },

      // Frågetyp (pedagogisk)
      "kind": {
        "mustBeOneOf": ["mcq_single", "true_false", "short_answer", "numeric"]
      },

      "block": { "mustFollow": "blockContract" },

      // Maskinbar kvalitetskontroll (fail-closed)
      "quality": {
        "requiredFields": [
          "isUnambiguous",
          "isGradable",
          "noMetaText",
          "antiGenericOk"
        ],
        "fieldRules": {
          "isUnambiguous": { "mustEqual": true },
          "isGradable": { "mustEqual": true },
          "noMetaText": { "mustEqual": true },
          "antiGenericOk": { "mustEqual": true }
        },
        "additionalProperties": false
      }
    },

    "additionalProperties": false
  },

  // ------------------------------------------------------------
  // FRÅGETYPER
  // ------------------------------------------------------------
  "questionKinds": {
    "allowed": ["mcq_single", "true_false", "short_answer", "numeric"],
    "default": "mcq_single"
  },

  // ------------------------------------------------------------
  // FACIT / ANSWERKEY
  // ------------------------------------------------------------
  "answerKeyContract": {
    "strictByKind": true,

    "requiredFieldsByKind": {
      "mcq_single": ["kind", "correctChoiceId"],
      "true_false": ["kind", "correctBoolean"],
      "short_answer": ["kind", "rubric"],
      "numeric": ["kind", "correctNumber"]
    },

    // Förbjud fel fält per kind
    "forbiddenFieldsByKind": {
      "mcq_single": ["correctBoolean", "correctNumber"],
      "true_false": ["correctChoiceId", "correctNumber"],
      "short_answer": ["correctChoiceId", "correctBoolean", "correctNumber"],
      "numeric": ["correctChoiceId", "correctBoolean", "rubric"]
    }
  },

  // ------------------------------------------------------------
  // MCQ-REGLER
  // ------------------------------------------------------------
  "mcqRules": {
    "choices": {
      "required": true,
      "minItems": 3,
      "maxItems": 5,
      "choiceShape": {
        "requiredFields": ["id", "label"],
        "idPattern": "^[A-E]$",
        "labelMaxChars": 140
      }
    },

    // 🔒 NYTT LÅS (v1.3):
    // MCQ + math ⇒ explanation krävs
    "mathMethodRequirement": {
      "when": {
        "meta.tagsContains": "math"
      },
      "then": {
        "explanationRequired": true,
        "workedStepsRecommended": true
      },
      "notes": [
        "Förhindrar gissningsprov i matematik.",
        "Samma pedagogiska krav som numeric."
      ]
    }
  },

  // ------------------------------------------------------------
  // NUMERIC-REGLER (MATTE)
  // ------------------------------------------------------------
  "numericRules": {
    "correctNumber": { "required": true },

    // 🔒 ALLTID krav på metod
    "explanationRequired": true,

    // Stegvis lösning rekommenderas starkt
    "workedStepsRecommended": true,

    "explanationStyle": {
      "mode": "stepwise_short",
      "notes": [
        "1–6 korta steg",
        "beskriver metod, inte resonemang i text"
      ]
    }
  },

  // ------------------------------------------------------------
  // META
  // ------------------------------------------------------------
  "metaRules": {
    "shape": {
      "difficulty": { "min": 1, "max": 4, "default": 2 },
      "mins": { "min": 1, "max": 20, "default": 5 },
      "tags": { "maxItems": 8, "tagMaxChars": 20 }
    }
  },

  // ------------------------------------------------------------
  // SPRÅK & TON
  // ------------------------------------------------------------
  "languageToneRules": {
    "must": [
      "Kort, sakligt provspråk",
      "Ingen meta-text",
      "Ingen pratighet"
    ],
    "avoidPhrases": [
      "som AI",
      "här är",
      "det beror på",
      "generellt sett",
      "tips:"
    ]
  },

  // ------------------------------------------------------------
  // ÄNDRINGSLOGG
  // ------------------------------------------------------------
  "changeLog": [
    "v1.3: Låst metodkrav för mcq_single när meta.tags innehåller 'math'.",
    "v1.3: Numeric kräver alltid explanation (stegvis metod).",
    "v1.3: Inline-kommentarer för tydlighet."
  ]
}
