{
  "version": "ai-rules/v1",
  "type": "format",
  "name": "question",
  "updatedAt": "2026-01-20",
  "purpose": [
    "Standardformat for fraga (quiz) som AI ska leverera och som UI/contract kan validera.",
    "Minimera feltolkning mellan worker, UI och lagring."
  ],
  "constraints": {
    "noPII": true,
    "choiceCountMin": 3,
    "choiceCountMax": 5,
    "choiceIdPattern": "^c[1-9][0-9]*$",
    "textMaxLen": 700,
    "choiceTextMaxLen": 180,
    "rationaleMaxLen": 500,
    "difficultyAllowed": ["intro", "normal", "advanced"]
  },
  "schema": {
    "item": {
      "type": "object",
      "required": ["kind", "text", "choices", "correctChoiceId"],
      "properties": {
        "kind": {
          "const": "question",
          "description": "Maste vara 'question'."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700,
          "description": "Själva frågetexten."
        },
        "choices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^c[1-9][0-9]*$",
                "description": "Val-id, t.ex. c1, c2, c3."
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "description": "Svarsalternativets text."
              }
            },
            "additionalProperties": false
          },
          "description": "Svarsalternativ 3–5 st."
        },
        "correctChoiceId": {
          "type": "string",
          "pattern": "^c[1-9][0-9]*$",
          "description": "Maste matcha en choices[].id."
        },
        "rationale": {
          "type": "string",
          "maxLength": 500,
          "description": "Kort motivering/for-klaring (valfri)."
        },
        "difficulty": {
          "type": "string",
          "enum": ["intro", "normal", "advanced"],
          "description": "Valfri svårighetsgrad."
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 32 },
          "description": "Valfria etiketter (t.ex. 'scenario', 'policy')."
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "kind": "question",
      "text": "Vilket är ett bra första steg om du misstänker phishing i ett mail?",
      "choices": [
        { "id": "c1", "text": "Klicka på länken för att se vart den leder" },
        { "id": "c2", "text": "Rapportera mailet enligt rutin och radera det" },
        { "id": "c3", "text": "Svara avsändaren och be om förklaring" }
      ],
      "correctChoiceId": "c2",
      "rationale": "Rapportera enligt rutin minskar risk och gör att fler kan skyddas.",
      "difficulty": "intro",
      "tags": ["infosec", "phishing"]
    }
  ]
}
