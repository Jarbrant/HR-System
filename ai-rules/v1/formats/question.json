{
  "id": "format-question-v1.1",
  "format": "question",
  "description": "Formatregler för en enskild provfråga (question-block). Fail-closed: answerKey krävs alltid. Beteendefrågor stöds via short_answer + rubric.",

  "outputContract": {
    "requiredFields": ["type", "title", "question", "answerKey"],
    "optionalFields": ["choices", "explanation", "meta"],
    "fieldRules": {
      "type": { "mustEqual": "question" },
      "title": { "minChars": 4, "maxChars": 80 },
      "question": { "minChars": 12, "maxChars": 260 }
    },
    "guards": {
      "failClosed": true,
      "notes": [
        "Question-format används för prov/kontrollfrågor och måste vara rättningsbart.",
        "Reflektionsfrågor utan facit ska inte använda detta format (hör hemma i dokument/info)."
      ]
    }
  },

  "kinds": {
    "allowed": ["mcq_single", "true_false", "short_answer", "numeric"],
    "defaultKind": "mcq_single"
  },

  "antiGeneric": {
    "forbidInQuestionText": [
      "utför uppgiften",
      "beskriv hur du tänkte",
      "lämna in",
      "mellanled",
      "reflektera",
      "diskutera",
      "sammanfatta teorin",
      "viktigaste poängen i teorin"
    ],
    "notes": [
      "Om frågan blir en generell instruktion → den är inte en provfråga och ska blockeras."
    ]
  },

  "kindContracts": {
    "mcq_single": {
      "requiredFields": ["choices"],
      "choicesRules": {
        "minItems": 3,
        "maxItems": 5,
        "uniqueIds": true
      },
      "answerKeyRules": {
        "required": true,
        "mustHave": ["kind", "correctChoiceId"],
        "kindMustEqual": "mcq_single"
      }
    },

    "true_false": {
      "requiredFields": [],
      "answerKeyRules": {
        "required": true,
        "mustHave": ["kind", "correctBoolean"],
        "kindMustEqual": "true_false"
      }
    },

    "short_answer": {
      "requiredFields": [],
      "answerKeyRules": {
        "required": true,
        "mustHave": ["kind", "rubric"],
        "kindMustEqual": "short_answer",
        "rubricMin": 3,
        "rubricMax": 5,
        "rubricStyle": [
          "kriterier ska vara mätbara",
          "undvik subjektiva ord utan definition"
        ]
      },
      "answerLengthGuidance": {
        "maxSentences": 2,
        "notes": [
          "Short_answer ska vara kort och rättningsbart via rubric."
        ]
      }
    },

    "numeric": {
      "requiredFields": [],
      "answerKeyRules": {
        "required": true,
        "mustHave": ["kind", "correctNumber"],
        "kindMustEqual": "numeric",
        "optional": ["tolerance", "unit", "rounding"]
      }
    }
  },

  "explanationPolicy": {
    "default": {
      "required": false,
      "maxSentences": 6
    },
    "overrides": [
      {
        "when": { "answerKey.kind": "true_false" },
        "then": { "required": true, "maxSentences": 4 }
      },
      {
        "when": { "answerKey.kind": "short_answer" },
        "then": { "required": true, "maxSentences": 5 }
      },
      {
        "when": { "answerKey.kind": "numeric" },
        "then": { "required": true, "maxSentences": 6 }
      }
    ],
    "notes": [
      "Explanation ska vara kort, verifierbar och stödja rättning.",
      "För short_answer beskriver explanation vad som bedöms (kopplat till rubric)."
    ]
  },

  "metaDefaults": {
    "difficulty": { "min": 1, "max": 5, "default": 2 },
    "mins": { "min": 1, "max": 20, "default": 5 },
    "tags": { "maxItems": 10 }
  },

  "changeLog": [
    "v1.1: Fail-closed question-format: answerKey krävs alltid.",
    "v1.1: Short_answer stödjer beteendefrågor via rubric (3–5 kriterier).",
    "v1.1: Blockerar generiska 'utför uppgiften/beskriv hur du tänkte'-mallar i question."
  ]
}
