{
  "version": "ai-rules/v1",
  "type": "format",
  "name": "question",
  "updatedAt": "2026-01-20",
  "purpose": [
    "Standardformat för provfrågor som kan auto-rättas.",
    "Matchar result.json (responseShapes) och step_policy.json (rekommenderade typer per steg).",
    "Förhindrar otydliga uppgifter: fråga + svarsalternativ + facit måste vara deterministiskt."
  ],
  "constraints": {
    "noPII": true,
    "language": "sv-SE",
    "typesAllowed": ["mcq_single", "mcq_multi", "true_false", "numeric", "short_answer"],
    "maxOptions": 6,
    "minOptions": 2,
    "shortAnswerMaxCharsLimit": 160,
    "numericDefaultTolerance": 0,
    "forbiddenPhrases": [
      "beskriv hur du tänkte",
      "reflektera",
      "diskutera",
      "lämna in",
      "utför uppgiften",
      "mellanled"
    ]
  },
  "schema": {
    "required": [
      "id",
      "type",
      "prompt",
      "context",
      "difficulty",
      "answer"
    ],
    "properties": {
      "id": { "type": "string", "description": "q_..." },
      "type": {
        "type": "string",
        "enum": ["mcq_single", "mcq_multi", "true_false", "numeric", "short_answer"]
      },
      "prompt": {
        "type": "object",
        "required": ["title", "text"],
        "properties": {
          "title": { "type": "string", "maxLength": 90 },
          "text": { "type": "string", "maxLength": 600 }
        }
      },
      "context": {
        "type": "object",
        "required": ["moduleId", "areaId", "chapterId", "step"],
        "properties": {
          "moduleId": { "type": "string" },
          "areaId": { "type": "string" },
          "chapterId": { "type": "string" },
          "step": { "type": "string", "enum": ["1", "2", "3", "4", "5"] },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "difficulty": { "type": "string", "enum": ["intro", "normal", "advanced"] },

      "options": {
        "type": "array",
        "description": "Endast för mcq_*",
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "properties": {
            "id": { "type": "string", "description": "opt_a/opt_b/..." },
            "text": { "type": "string", "maxLength": 180 }
          }
        }
      },

      "answer": {
        "type": "object",
        "description": "Facit (deterministiskt).",
        "required": ["shape", "value"],
        "properties": {
          "shape": {
            "type": "string",
            "enum": ["single", "multi", "bool", "number", "short"]
          },
          "value": {},
          "tolerance": { "type": "number", "description": "Endast numeric. Default 0." },
          "explanation": {
            "type": "string",
            "maxLength": 400,
            "description": "Kort förklaring som kan visas som feedback (valfri)."
          }
        }
      },

      "scoring": {
        "type": "object",
        "description": "Valfritt – annars 1 poäng per fråga.",
        "properties": {
          "points": { "type": "number", "default": 1 },
          "critical": {
            "type": "boolean",
            "default": false,
            "description": "Om true: fel svar kan trigga managerFollowup-flagga."
          }
        }
      }
    }
  },

  "answerRules": [
    {
      "type": "mcq_single",
      "requires": ["options"],
      "answerShape": "single",
      "answerValueType": "string",
      "answerValueRule": "value måste vara ett options[].id"
    },
    {
      "type": "mcq_multi",
      "requires": ["options"],
      "answerShape": "multi",
      "answerValueType": "array",
      "answerValueRule": "value måste vara array av options[].id (min 1)"
    },
    {
      "type": "true_false",
      "answerShape": "bool",
      "answerValueType": "boolean"
    },
    {
      "type": "numeric",
      "answerShape": "number",
      "answerValueType": "number",
      "toleranceDefault": 0
    },
    {
      "type": "short_answer",
      "answerShape": "short",
      "answerValueType": "string",
      "answerValueRule": "max 160 tecken, får inte vara essä. Ska vara styrbart och rättningsbart (exakt match eller whitelist)."
    }
  ],

  "validationRules": [
    {
      "rule": "forbidden_phrases",
      "description": "prompt.title/text får inte innehålla forbiddenPhrases."
    },
    {
      "rule": "options_required_for_mcq",
      "description": "mcq_single/mcq_multi måste ha options med 2–6 alternativ."
    },
    {
      "rule": "answer_matches_type",
      "description": "answer.shape och answer.value måste matcha type enligt answerRules."
    },
    {
      "rule": "no_inner_html",
      "description": "All text ska tolkas som ren text (UI använder textContent)."
    }
  ],

  "examples": [
    {
      "id": "q_ex_001",
      "type": "mcq_single",
      "prompt": {
        "title": "Avvikelse: första åtgärd",
        "text": "En avvikelse upptäcks i en rutin. Vad är första korrekta åtgärden?"
      },
      "context": {
        "moduleId": "mod_quality",
        "areaId": "ar_deviation",
        "chapterId": "ch_4_scenario",
        "step": "2",
        "tags": ["scenario"]
      },
      "difficulty": "normal",
      "options": [
        { "id": "opt_a", "text": "Ignorera tills nästa möte" },
        { "id": "opt_b", "text": "Registrera avvikelsen enligt rutin" },
        { "id": "opt_c", "text": "Vänta och se om det händer igen" }
      ],
      "answer": {
        "shape": "single",
        "value": "opt_b",
        "explanation": "Avvikelser ska registreras direkt enligt fastställd rutin."
      },
      "scoring": { "points": 1, "critical": true }
    }
  ]
}
