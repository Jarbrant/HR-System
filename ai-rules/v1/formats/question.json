{
  "version": "ai-rules/v1",
  "type": "format",
  "name": "question",
  "updatedAt": "2026-01-20",
  "purpose": [
    "Standardformat för frågor som kan auto-rättas.",
    "Låst till kryss-frågor (single/multi) för att förenkla elev-svar och rapportering till MANAGER."
  ],
  "constraints": {
    "grading": "auto",
    "allowedQuestionKinds": ["choice_single", "choice_multi"],
    "disallowFreeTextAnswers": true,
    "maxPromptChars": 600,
    "maxChoiceTextChars": 120,
    "minChoices": 2,
    "maxChoices": 6,
    "minCorrect": 1,
    "maxCorrectSingle": 1,
    "maxCorrectMulti": 3,
    "language": "sv-SE",
    "noPII": true
  },
  "schema": {
    "required": [
      "id",
      "kind",
      "prompt",
      "choices",
      "answerKey",
      "explanation",
      "difficulty",
      "tags"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unikt id för frågan (ex q_...)."
      },
      "kind": {
        "type": "string",
        "enum": ["choice_single", "choice_multi"],
        "description": "choice_single = ett rätt svar. choice_multi = flera rätt svar."
      },
      "prompt": {
        "type": "string",
        "description": "Själva frågetexten. Ska vara tydlig, kort och utan fluff."
      },
      "choices": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "properties": {
            "id": {
              "type": "string",
              "description": "Svarsalternativets id: A, B, C, D, E, F."
            },
            "text": {
              "type": "string",
              "description": "Svarsalternativets text (max 120 tecken)."
            }
          }
        }
      },
      "answerKey": {
        "type": "object",
        "required": ["correctChoiceIds"],
        "properties": {
          "correctChoiceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string" }
          }
        },
        "description": "Rätt svar: array av choice-ids (t.ex. ['B'] eller ['A','D'])."
      },
      "explanation": {
        "type": "string",
        "description": "Kort förklaring varför svaret är rätt. Visas efter rättning."
      },
      "difficulty": {
        "type": "string",
        "enum": ["intro", "normal", "advanced"],
        "description": "Svårighetsgrad."
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Taggar för filtrering (ex: 'ISO9001', 'scenario', 'kapitel:Introduktion', 'steg:1')."
      },
      "meta": {
        "type": "object",
        "description": "Valfri metadata, men får inte innehålla persondata."
      }
    }
  },
  "examples": [
    {
      "id": "q_example_001",
      "kind": "choice_single",
      "prompt": "Vilket är syftet med en avvikelsehantering?",
      "choices": [
        { "id": "A", "text": "Att hitta någon att skylla på." },
        { "id": "B", "text": "Att upptäcka, åtgärda och förebygga att felet händer igen." },
        { "id": "C", "text": "Att spara tid genom att hoppa över dokumentation." }
      ],
      "answerKey": { "correctChoiceIds": ["B"] },
      "explanation": "Avvikelsehantering ska leda till korrigering och förebyggande åtgärder, inte skuld.",
      "difficulty": "intro",
      "tags": ["Kvalitet", "Avvikelse", "kapitel:Introduktion", "steg:1"]
    }
  ],
  "validationRules": [
    {
      "rule": "choices_ids_unique",
      "description": "Alla choices[].id måste vara unika."
    },
    {
      "rule": "choice_ids_allowed",
      "description": "choices[].id måste vara en av A,B,C,D,E,F."
    },
    {
      "rule": "answerKey_subset_of_choices",
      "description": "answerKey.correctChoiceIds måste finnas i choices[].id."
    },
    {
      "rule": "single_has_one_correct",
      "description": "Om kind=choice_single måste correctChoiceIds ha exakt 1 id."
    },
    {
      "rule": "multi_has_1_to_3_correct",
      "description": "Om kind=choice_multi måste correctChoiceIds ha 1–3 id."
    },
    {
      "rule": "no_free_text",
      "description": "Inga fält för fri text-svar får förekomma."
    }
  ],
  "uiHints": {
    "studentAnswerShape": {
      "choice_single": { "selectedChoiceId": "B" },
      "choice_multi": { "selectedChoiceIds": ["A", "D"] }
    },
    "teacherReportShape": {
      "questionId": "q_example_001",
      "isCorrect": true,
      "selected": ["B"],
      "correct": ["B"]
    }
  }
}
