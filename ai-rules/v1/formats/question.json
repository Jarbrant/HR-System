{
  "version": "ai-rules/v1",
  "type": "format",
  "name": "question",
  "schema": "question.json/v1",
  "updatedAt": "2026-01-20",
  "purpose": [
    "Låser ett auto-rättningsbart frågeformat (kryss/val).",
    "Passar Employee (elev) -> Manager/Teacher (rättare) utan fri-text som kräver bedömning.",
    "Bygger ett stabilt kontrakt mellan AI-output och UI-block."
  ],
  "constraints": {
    "answerModeAllowed": ["single_choice", "multi_choice", "true_false"],
    "freeTextAllowed": false,
    "maxPromptChars": 900,
    "maxRationaleChars": 300,
    "maxOptions": 6,
    "minOptions": 2,
    "optionTextMaxChars": 140,
    "correctAnswersMax": 3,
    "idPattern": "^[a-z0-9_\\-]{6,64}$",
    "localeDefault": "sv-SE"
  },
  "question": {
    "required": [
      "id",
      "subject",
      "difficulty",
      "answerMode",
      "prompt",
      "options",
      "correctAnswers",
      "scoring"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Stabilt id för frågan (kan användas som blockId eller questionId).",
        "pattern": "^[a-z0-9_\\-]{6,64}$"
      },
      "subject": {
        "type": "object",
        "description": "Koppling till modul/område/kapitel/steg för frågemotor.",
        "required": ["module", "area", "chapter", "step"],
        "properties": {
          "module": { "type": "string", "minLength": 1, "maxLength": 80 },
          "area": { "type": "string", "minLength": 1, "maxLength": 80 },
          "chapter": { "type": "string", "minLength": 1, "maxLength": 80 },
          "step": {
            "type": "string",
            "description": "Steg 1..7 som sträng (stabilt i UI).",
            "enum": ["1", "2", "3", "4", "5", "6", "7"]
          }
        }
      },
      "difficulty": {
        "type": "string",
        "description": "Tre svårighetsgrader (låst).",
        "enum": ["intro", "normal", "advanced"]
      },
      "answerMode": {
        "type": "string",
        "description": "Endast auto-rättningsbara modes (låst).",
        "enum": ["single_choice", "multi_choice", "true_false"]
      },
      "prompt": {
        "type": "string",
        "description": "Frågetext (ingen fri text-svar).",
        "minLength": 5,
        "maxLength": 900
      },
      "options": {
        "type": "array",
        "description": "Svarsalternativ. För true_false ska den vara exakt [Sant, Falskt] i sv-SE.",
        "minItems": 2,
        "maxItems": 6,
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "properties": {
            "id": {
              "type": "string",
              "description": "A, B, C... eller o1, o2 ... men stabilt per fråga.",
              "pattern": "^[A-Za-z0-9_\\-]{1,8}$"
            },
            "text": { "type": "string", "minLength": 1, "maxLength": 140 }
          }
        }
      },
      "correctAnswers": {
        "type": "array",
        "description": "Lista av option.id som är korrekta. single_choice/true_false => exakt 1.",
        "minItems": 1,
        "maxItems": 3,
        "items": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,8}$" }
      },
      "rationale": {
        "type": "string",
        "description": "Kort facitförklaring (för läraren/manager). Visas inte för employee i provläge.",
        "maxLength": 300
      },
      "tags": {
        "type": "array",
        "description": "Valfritt: 'scenario', 'policy', 'safety', 'iso' etc.",
        "maxItems": 12,
        "items": { "type": "string", "maxLength": 24 }
      },
      "scoring": {
        "type": "object",
        "description": "Auto-rättning: poäng per fråga.",
        "required": ["points", "negativePoints", "partialCredit"],
        "properties": {
          "points": { "type": "number", "minimum": 0, "maximum": 10 },
          "negativePoints": { "type": "number", "minimum": 0, "maximum": 10 },
          "partialCredit": {
            "type": "boolean",
            "description": "Endast relevant vid multi_choice. false => allt-eller-inget."
          }
        }
      },
      "presentation": {
        "type": "object",
        "description": "UI-hints (inte logik).",
        "properties": {
          "shuffleOptions": { "type": "boolean" },
          "timeLimitSec": { "type": "number", "minimum": 0, "maximum": 3600 }
        }
      },
      "meta": {
        "type": "object",
        "description": "Spårbarhet, men inte PII.",
        "properties": {
          "createdAt": { "type": "number" },
          "createdBy": { "type": "string", "maxLength": 64 },
          "source": { "type": "string", "maxLength": 64 }
        }
      }
    }
  },
  "answerSheet": {
    "version": "answer-sheet/v1",
    "purpose": [
      "Hur Employee svarar (kan lagras senare i 'pärmen för provresultat').",
      "Auto-rättning: jämför selected vs correctAnswers."
    ],
    "required": ["attemptId", "questionId", "answerMode", "selected", "answeredAt"],
    "properties": {
      "attemptId": {
        "type": "string",
        "description": "Unikt id för provtillfälle/attempt.",
        "pattern": "^[a-z0-9_\\-]{6,64}$"
      },
      "questionId": {
        "type": "string",
        "description": "Måste matcha question.id",
        "pattern": "^[a-z0-9_\\-]{6,64}$"
      },
      "answerMode": {
        "type": "string",
        "enum": ["single_choice", "multi_choice", "true_false"]
      },
      "selected": {
        "type": "array",
        "description": "Valda option.id. single_choice/true_false => exakt 1.",
        "minItems": 1,
        "maxItems": 3,
        "items": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,8}$" }
      },
      "answeredAt": { "type": "number", "description": "epoch ms" },
      "elapsedMs": { "type": "number", "minimum": 0, "maximum": 3600000 }
    }
  },
  "validationRules": [
    {
      "id": "Q01_true_false_options",
      "when": "answerMode == 'true_false'",
      "must": "options.length == 2 AND options[0].text == 'Sant' AND options[1].text == 'Falskt'"
    },
    {
      "id": "Q02_single_choice_correct",
      "when": "answerMode == 'single_choice' OR answerMode == 'true_false'",
      "must": "correctAnswers.length == 1"
    },
    {
      "id": "Q03_multi_choice_correct",
      "when": "answerMode == 'multi_choice'",
      "must": "correctAnswers.length >= 1 AND correctAnswers.length <= 3"
    },
    {
      "id": "Q04_unique_option_ids",
      "when": "always",
      "must": "options[].id unique"
    },
    {
      "id": "Q05_selected_matches_mode",
      "when": "answerSheet",
      "must": "answerMode != 'multi_choice' => selected.length == 1"
    }
  ],
  "examples": [
    {
      "question": {
        "id": "q_coldchain_1",
        "subject": { "module": "Livsmedel", "area": "Kylkedja", "chapter": "Introduktion", "step": "1" },
        "difficulty": "intro",
        "answerMode": "single_choice",
        "prompt": "Vilket är det viktigaste syftet med kylkedjan?",
        "options": [
          { "id": "A", "text": "Att maten håller rätt temperatur för att minska bakterietillväxt" },
          { "id": "B", "text": "Att packa snabbare" },
          { "id": "C", "text": "Att minska antalet leveranser" }
        ],
        "correctAnswers": ["A"],
        "rationale": "Rätt temperatur minskar risk för bakterietillväxt och matsäkerhetsproblem.",
        "tags": ["haccp", "coldchain"],
        "scoring": { "points": 1, "negativePoints": 0, "partialCredit": false },
        "presentation": { "shuffleOptions": true }
      },
      "answerSheet": {
        "attemptId": "att_9f31ab",
        "questionId": "q_coldchain_1",
        "answerMode": "single_choice",
        "selected": ["A"],
        "answeredAt": 1760000000000,
        "elapsedMs": 42000
      }
    }
  ]
}
