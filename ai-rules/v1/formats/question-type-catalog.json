  "description": "Pedagogisk katalog över tillåtna frågetyper för UI. Mappas till question-kinds via typeId → kind.",

  "uiContract": {
    "select": {
      "label": "Frågetyp",
      "valueField": "typeId",
      "displayField": "label",
      "required": true
