{
  "schema": "subjectsIndex/v1",
  "name": "subjects-index",
  "version": "v1.0",
  "updatedAt": "2026-02-01",
  "purpose": [
    "Enda sanning för vilka subjectId som är giltiga i ai-rules/v1.",
    "UI kan lista/validera val utan att gissa.",
    "Worker kan deterministiskt ignorera saknade subjectId utan crash."
  ],
  "policy": {
    "noPII": true,
    "failClosed": true,
    "genericMustExist": true
  },
  "defaults": {
    "fallbackSubjectIds": ["generic"]
  },

  "subjects": {
    "generic": {
      "label": "Generic",
      "path": "/ai-rules/v1/subjects/generic.json",
      "status": "active",
      "tags": ["fallback", "base"]
    },
    "ethics": {
      "label": "Ethics",
      "path": "/ai-rules/v1/subjects/ethics.json",
      "status": "planned",
      "tags": ["overlay", "safety"]
    },
    "hr_policy": {
      "label": "HR Policy",
      "path": "/ai-rules/v1/subjects/hr_policy.json",
      "status": "planned",
      "tags": ["hr", "policy"]
    },
    "feedback_samtal": {
      "label": "Feedback & samtal",
      "path": "/ai-rules/v1/subjects/feedback_samtal.json",
      "status": "active",
      "tags": ["hr", "communication"]
    },
    "math": {
      "label": "Matematik",
      "path": "/ai-rules/v1/subjects/math.json",
      "status": "active",
      "tags": ["school"]
    },
    "swedish": {
      "label": "Svenska",
      "path": "/ai-rules/v1/subjects/swedish.json",
      "status": "active",
      "tags": ["school", "language"]
    }
  },

  "list": [
    { "id": "generic", "path": "/ai-rules/v1/subjects/generic.json" },
    { "id": "ethics", "path": "/ai-rules/v1/subjects/ethics.json" },
    { "id": "hr_policy", "path": "/ai-rules/v1/subjects/hr_policy.json" },
    { "id": "feedback_samtal", "path": "/ai-rules/v1/subjects/feedback_samtal.json" },
    { "id": "math", "path": "/ai-rules/v1/subjects/math.json" },
    { "id": "swedish", "path": "/ai-rules/v1/subjects/swedish.json" }
  ],

  "validation": {
    "rules": [
      "subjects.generic måste finnas",
      "list[] ska bara innehålla id som finns i subjects{}",
      "path ska vara en absolut repo-path (börjar med /ai-rules/v1/)"
    ]
  },

  "notes": [
    "status=planned betyder att subjectId är reserverad i index men att filen kan saknas ännu.",
    "Resolver ska: dedupe+ordning, ignorera subjectId som saknas i index, och fallback till generic om listan blir tom."
  ]
}
